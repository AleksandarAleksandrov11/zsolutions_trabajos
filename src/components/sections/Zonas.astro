---
import { ArrowRight, MapPin } from "lucide-react";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import EnlaceBoton from "@/components/ui/EnlaceBoton.astro";
import Reveal from "@/components/ui/Reveal.astro";
import RevealGroup from "@/components/ui/RevealGroup.astro";
import RevealItem from "@/components/ui/RevealItem.astro";
import MapaZonas from "@/components/sections/MapaZonas.astro";
import { agrupaciones, zonas } from "@/content/zonas";
import { secciones } from "@/content/secciones";
import { fondoCss } from "@/lib/fondos";

type Props = { numero?: string };
const { numero = "06" } = Astro.props;

const publicadas = agrupaciones.filter((a) => a.publicada);
const nombreFondo = "fondo-fachadas" as const;
---

<section
  class="seccion-foto py-section"
  style={`--foto: ${fondoCss(nombreFondo)}; --foto-posicion: center bottom`}
  aria-labelledby="titulo-zonas"
>
  <div class="container-brand">
    <SectionHeading
      numero={numero}
      eyebrow={secciones.zonas.eyebrow}
      tituloId="titulo-zonas"
      titulo={secciones.zonas.titulo}
      descripcion={`Base en ${zonas[0].ciudad} y salida habitual a ${zonas.length} municipios. Si el tuyo no está, pregunta igualmente.`}
    />

    <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1fr)] lg:items-center lg:gap-16">
      <Reveal class="tarjeta p-5 sm:p-7">
        <MapaZonas />
        <p class="mt-4 text-xs text-fg-dim">
          Contorno real de Cataluña. Cada punto está en las coordenadas de su
          municipio y lleva a su zona.
        </p>
      </Reveal>

      <div>
        <RevealGroup as="ul" class="rejilla-igual sm:grid-cols-2" stagger={0.05}>
          {
            publicadas.map((grupo) => (
              <RevealItem as="li">
                <a href={`/zonas/${grupo.slug}`} class="tarjeta group flex h-full flex-col p-5">
                  <span class="flex items-center gap-2.5">
                    <MapPin className="h-4 w-4 shrink-0 text-brand-orange" aria-hidden="true" />
                    <span class="text-lg font-bold">{grupo.nombre}</span>
                  </span>
                  <span class="mt-2 block text-sm text-fg-muted">{grupo.entradilla}</span>
                  <span class="text-eyebrow mt-auto block pt-4 text-fg-dim transition-colors group-hover:text-fg">
                    {grupo.municipios.length}
                    {grupo.municipios.length === 1 ? " municipio" : " municipios"}
                  </span>
                </a>
              </RevealItem>
            ))
          }
        </RevealGroup>

        <div class="mt-8">
          <EnlaceBoton href="/zonas" variante="secundario">
            Ver el mapa y los {zonas.length} municipios
            <ArrowRight className="h-4 w-4" aria-hidden="true" />
          </EnlaceBoton>
        </div>
      </div>
    </div>
  </div>
</section>
