---
import { ArrowRight } from "lucide-react";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import EnlaceBoton from "@/components/ui/EnlaceBoton.astro";
import Reveal from "@/components/ui/Reveal.astro";
import AnimatedCounter from "@/components/ui/AnimatedCounter.astro";
import Foto from "@/components/ui/Foto.astro";
import { bioAlex } from "@/content/trayectoria";
import { certificaciones } from "@/content/certificaciones";
import { site } from "@/content/site";

type Props = { numero?: string };
const { numero = "04" } = Astro.props;

const ANIO_INICIO = 2012;
const anios = new Date().getFullYear() - ANIO_INICIO;

const cifras = [
  { valor: anios, sufijo: "", etiqueta: "años en obra" },
  { valor: certificaciones.length, sufijo: "", etiqueta: "acreditaciones" },
  { valor: 24, sufijo: " h", etiqueta: "para responderte" },
];
---

<section class="seccion-alterna py-section" aria-labelledby="titulo-alex">
  <div class="container-brand">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1fr)] lg:gap-16">
      <Reveal>
        <Foto
          nombre="alex-retrato-obra"
          alt="Alex Zsurzs con la ropa de trabajo de ZSolutions en una obra de Barcelona"
          ratio="4 / 5"
          sizes="(max-width: 1024px) 90vw, 420px"
          class="rounded-2xl"
          objectPosition="50% 22%"
        />
      </Reveal>

      <div>
        <SectionHeading
          numero={numero}
          eyebrow="Quién está detrás"
          tituloId="titulo-alex"
          titulo={site.fundador}
        />

        <p class="mt-6 text-lg text-fg-muted">{bioAlex}</p>

        <dl class="mt-10 grid grid-cols-3 gap-4">
          {
            cifras.map((c) => (
              <div class="tarjeta p-5">
                <dd class="font-display text-3xl">
                  <AnimatedCounter valor={c.valor} sufijo={c.sufijo} />
                </dd>
                <dt class="mt-1.5 text-xs text-fg-dim">{c.etiqueta}</dt>
              </div>
            ))
          }
        </dl>

        <div class="mt-9">
          <EnlaceBoton href="/sobre-alex" variante="secundario">
            Ver la trayectoria completa
            <ArrowRight className="h-4 w-4" aria-hidden="true" />
          </EnlaceBoton>
        </div>
      </div>
    </div>
  </div>
</section>
