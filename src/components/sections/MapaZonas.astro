---
import { hrefZona, siluetaCataluna, zonas } from "@/content/zonas";

type Props = { class?: string };
const { class: clase } = Astro.props;

/**
 * Mapa de zonas de actuación, navegable.
 *
 * El contorno es la frontera real de Cataluña (OpenStreetMap, simplificada y
 * proyectada), y cada punto está en la latitud y la longitud reales de su
 * municipio. No es un esquema: si se añade una zona nueva a `zonas.ts` con sus
 * coordenadas, aparece en su sitio.
 *
 * Cada municipio es un enlace de verdad, no un `onclick`: funciona con ratón,
 * con dedo, con teclado y con el botón central del ratón. Encima del punto
 * visible, que mide entre 2 y 5 px, hay un círculo transparente de 22 px para
 * que se pueda tocar con el dedo sin apuntar.
 *
 * La lista de al lado sigue siendo el camino principal para un lector de
 * pantalla; el mapa se anuncia como lo que es y sus enlaces llevan el nombre
 * completo del municipio.
 */
const { ancho, alto, camino } = siluetaCataluna;
const conEtiqueta = zonas.filter((z) => z.etiqueta);
---

<div class={clase}>
  <svg
    viewBox={`0 0 ${ancho} ${alto}`}
    class="mapa-zonas w-full"
    role="group"
    aria-labelledby="mapa-zonas-titulo mapa-zonas-desc"
  >
    <title id="mapa-zonas-titulo">Mapa de zonas de actuación</title>
    <desc id="mapa-zonas-desc">
      Contorno de Cataluña con los {zonas.length} municipios en los que trabaja ZSolutions.
      Cada punto es un enlace a su zona.
    </desc>

    <path
      d={camino}
      fill="rgba(47,74,160,.28)"
      stroke="#3D5FC4"
      stroke-width="1.2"
      stroke-linejoin="round"></path>

    {/* Radio de trabajo habitual alrededor de Barcelona */}
    <circle
      cx="272.8"
      cy="268.1"
      r="42"
      fill="none"
      stroke="rgba(61,95,196,.4)"
      stroke-width="1"
      stroke-dasharray="3 5"></circle>

    {
      zonas.map((z) => {
        const base = z.slug === "barcelona";
        return (
          <a
            href={hrefZona(z)}
            class="punto-zona"
            data-zona={z.slug}
            aria-label={`${z.nombreLargo}, ${z.comarca}`}
          >
            {/* Área táctil: invisible, pero es la que recibe el dedo. */}
            <circle cx={z.mapa.x} cy={z.mapa.y} r="11" fill="transparent" />
            <circle
              class="punto-zona-marca"
              cx={z.mapa.x}
              cy={z.mapa.y}
              r={base ? 4.5 : 2.4}
              fill={base ? "#FF7A1A" : "#FFFFFF"}
              opacity={base ? 1 : 0.8}
            />
          </a>
        );
      })
    }

    {
      conEtiqueta.map((z) => (
        <text
          class="etiqueta-zona"
          data-etiqueta={z.slug}
          x={z.mapa.x + z.etiqueta!.dx}
          y={z.mapa.y + z.etiqueta!.dy}
          fill="#C7C7CC"
          font-size="9.5"
          text-anchor={z.etiqueta!.anclaje ?? "start"}
          font-family="Arial, Helvetica, sans-serif"
          aria-hidden="true"
        >
          {z.ciudad}
        </text>
      ))
    }
  </svg>
</div>

<script>
  /* Mapa y listado se iluminan a la vez: al señalar un punto se marca su fila
     de la lista, y al revés. Es lo que hace que el mapa se entienda sin tener
     que rotular los veintiún municipios, que a esta escala no caben. */
  const mapa = document.querySelector<SVGSVGElement>(".mapa-zonas");
  if (mapa) {
    const marcar = (slug: string | null, activo: boolean) => {
      if (!slug) return;
      mapa
        .querySelector(`.punto-zona[data-zona="${slug}"]`)
        ?.classList.toggle("senalada", activo);
      mapa
        .querySelector(`[data-etiqueta="${slug}"]`)
        ?.classList.toggle("senalada", activo);
      document
        .querySelector(`[data-fila-zona="${slug}"]`)
        ?.classList.toggle("senalada", activo);
    };

    for (const evento of ["pointerenter", "focusin"] as const) {
      mapa.addEventListener(
        evento,
        (e) => marcar((e.target as Element).closest<SVGAElement>(".punto-zona")?.dataset.zona ?? null, true),
        true,
      );
    }
    for (const evento of ["pointerleave", "focusout"] as const) {
      mapa.addEventListener(
        evento,
        (e) => marcar((e.target as Element).closest<SVGAElement>(".punto-zona")?.dataset.zona ?? null, false),
        true,
      );
    }

    for (const fila of document.querySelectorAll<HTMLElement>("[data-fila-zona]")) {
      const slug = fila.dataset.filaZona ?? null;
      fila.addEventListener("pointerenter", () => marcar(slug, true));
      fila.addEventListener("pointerleave", () => marcar(slug, false));
      fila.addEventListener("focusin", () => marcar(slug, true));
      fila.addEventListener("focusout", () => marcar(slug, false));
    }
  }
</script>
