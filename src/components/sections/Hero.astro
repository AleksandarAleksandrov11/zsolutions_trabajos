---
import { ArrowRight, MessageCircle } from "lucide-react";
import EnlaceBoton from "@/components/ui/EnlaceBoton.astro";
import Foto from "@/components/ui/Foto.astro";
import type { NombreFoto } from "@/content/fotos";
import { barraConfianza, hrefWhatsApp, mensajeWhatsApp } from "@/content/site";

type Props = {
  eyebrow: string;
  /** Cada string es una línea del titular, revelada con máscara. */
  lineas: string[];
  descripcion: string;
  /** Solo la home lleva el hero a pantalla completa. */
  completo?: boolean;
  conBarraConfianza?: boolean;
  /** Fotografía real de fondo. Si no hay, queda la composición gráfica. */
  foto?: { nombre: NombreFoto; alt: string; posicion?: string };
};

const {
  eyebrow,
  lineas,
  descripcion,
  completo = false,
  conBarraConfianza = false,
  foto,
} = Astro.props;

/**
 * Hero de portada y de cabecera de sección.
 *
 * Toda la animación de entrada es CSS: el titular sube por líneas tras una
 * máscara y el resto entra con un fundido corto. El bloque más importante de
 * la página se pinta directamente desde el HTML, sin esperar a ningún script.
 * El parallax del fondo lo aplica el script global, y solo si el visitante no
 * ha pedido menos movimiento.
 */
const estiloSeccion = [
  completo ? "min-height:100dvh" : null,
  `padding-top:${completo ? "clamp(8rem, 18vh, 12rem)" : "clamp(8rem, 16vh, 11rem)"}`,
  `padding-bottom:${completo ? "clamp(3rem, 8vh, 6rem)" : "clamp(3rem, 6vh, 4.5rem)"}`,
]
  .filter(Boolean)
  .join(";");

const fondoGradiente = foto
  ? "linear-gradient(100deg, rgba(15,15,16,.94) 0%, rgba(15,15,16,.72) 42%, rgba(35,54,111,.45) 100%)"
  : "radial-gradient(75% 62% at 78% 6%, rgba(35,54,111,.85) 0%, transparent 60%), radial-gradient(60% 55% at 8% 92%, rgba(47,74,160,.35) 0%, transparent 62%)";
---

<section
  class="relative isolate flex flex-col justify-end overflow-hidden"
  data-hero
  style={estiloSeccion}
>
  {/* Fondo: fotografía real de obra con la capa de color corporativo al
      60–80 %, como pide el apartado 05 del manual. Si no hay foto, queda la
      composición gráfica sola. */}
  <div class="absolute inset-0 -z-10" data-hero-fondo aria-hidden="true">
    {
      foto ? (
        <Foto
          nombre={foto.nombre}
          alt=""
          priority
          tratamiento="bn"
          sizes="(max-width: 767px) 55vw, 100vw"
          class="absolute inset-0 h-full w-full scale-[1.05]"
          objectPosition={foto.posicion ?? "62% 30%"}
        />
      ) : null
    }
    {foto ? <div class="capa-corporativa absolute inset-0" /> : null}
    <div class="grid-plano absolute inset-0"></div>
    <div class="absolute inset-0" style={`background:${fondoGradiente}`}></div>
    <div
      class="rayas-z absolute -right-24 top-1/4 h-72 w-[36rem] opacity-30"
      style="mask-image:linear-gradient(to left, black, transparent)"
    >
    </div>
    {/* Viñeteado */}
    <div
      class="absolute inset-0"
      style="background:radial-gradient(120% 100% at 50% 50%, transparent 40%, rgba(15,15,16,.85) 100%)"
    >
    </div>
  </div>

  <div class="container-brand relative">
    <p
      class="text-eyebrow mb-6 flex items-center gap-3 text-brand-orange"
      data-hero-fundido
      style="--retardo:0.05s"
    >
      <span class="rayas-z inline-block h-3 w-10" aria-hidden="true"></span>
      {eyebrow}
    </p>

    <h1 class="max-w-5xl text-7xl">
      {
        lineas.map((linea, i) => (
          <span class="hero-linea">
            <span style={`--retardo:${(0.08 + i * 0.09).toFixed(2)}s`}>{linea}</span>
          </span>
        ))
      }
    </h1>

    <p
      class="mt-7 max-w-2xl text-lg text-fg-muted"
      data-hero-fundido
      style="--retardo:0.3s"
    >
      {descripcion}
    </p>

    {/* Los CTA aparecen con un fundido corto: nunca se hacen esperar. */}
    <div
      class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center"
      data-hero-fundido
      style="--retardo:0.38s"
    >
      <EnlaceBoton href="/contacto" tamano="lg">
        Solicitar presupuesto
        <ArrowRight className="h-4 w-4" aria-hidden="true" />
      </EnlaceBoton>
      <EnlaceBoton href={hrefWhatsApp(mensajeWhatsApp)} variante="secundario" tamano="lg">
        <MessageCircle className="h-4 w-4" aria-hidden="true" />
        WhatsApp
      </EnlaceBoton>
    </div>

    {
      conBarraConfianza ? (
        <div
          class="mt-12 border-t border-white/10 pt-6"
          data-hero-fundido
          style="--retardo:0.5s"
        >
          <ul class="flex flex-wrap items-center gap-x-6 gap-y-3">
            {barraConfianza.map((item) => (
              <li class="text-eyebrow flex items-center gap-2.5 text-fg-muted/75">
                <span class="h-1.5 w-1.5 shrink-0 bg-brand-blue" aria-hidden="true" />
                {item}
              </li>
            ))}
          </ul>
        </div>
      ) : null
    }
  </div>
</section>
