---
import { ArrowRight, MessageCircle } from "lucide-react";
import EnlaceBoton from "@/components/ui/EnlaceBoton.astro";
import Foto from "@/components/ui/Foto.astro";
import type { NombreFoto } from "@/content/fotos";
import { barraConfianza, hrefWhatsApp, mensajeWhatsApp } from "@/content/site";

type Props = {
  eyebrow: string;
  titulo: string;
  descripcion: string;
  foto: {
    nombre: NombreFoto;
    alt: string;
    /** Encuadre en móvil y en pantalla ancha: el sujeto no cae igual. */
    posicionMovil?: string;
    posicion?: string;
  };
  /** Solo la portada ocupa la pantalla completa. */
  portada?: boolean;
  conBarraConfianza?: boolean;
};

const {
  eyebrow,
  titulo,
  descripcion,
  foto,
  portada = false,
  conBarraConfianza = false,
} = Astro.props;

/* Tailwind busca las clases escritas literalmente en el código, así que no
   valen las construidas al vuelo: el encuadre se elige entre estos pares. */
const encuadres = {
  "62% 18%": {
    movil: "[&_img]:object-[62%_18%]",
    ancho: "lg:[&_img]:object-[62%_18%]",
  },
  "55% 25%": {
    movil: "[&_img]:object-[55%_25%]",
    ancho: "lg:[&_img]:object-[55%_25%]",
  },
  "50% 30%": {
    movil: "[&_img]:object-[50%_30%]",
    ancho: "lg:[&_img]:object-[50%_30%]",
  },
  "70% 25%": {
    movil: "[&_img]:object-[70%_25%]",
    ancho: "lg:[&_img]:object-[70%_25%]",
  },
} as const;

type Encuadre = keyof typeof encuadres;
const movil = encuadres[(foto.posicionMovil ?? "50% 30%") as Encuadre].movil;
const ancho = encuadres[(foto.posicion ?? "50% 30%") as Encuadre].ancho;
---

<section
  class:list={[
    "relative isolate flex flex-col justify-end overflow-hidden",
    portada
      ? "min-h-[88svh] pt-32 pb-14 sm:min-h-[92svh] sm:pb-20"
      : "pt-32 pb-14 sm:pt-40 sm:pb-20",
  ]}
>
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <Foto
      nombre={foto.nombre}
      alt=""
      priority
      sizes="100vw"
      class={`absolute inset-0 h-full w-full ${movil} ${ancho}`}
    />
    {/* Degradados: legibilidad del texto sin tocar la foto. En pantalla ancha
        el oscurecido va de izquierda a derecha; en móvil, de abajo arriba. */}
    <div class="absolute inset-0 bg-gradient-to-t from-bg from-30% via-bg/88 via-62% to-bg/25 lg:hidden"></div>
    <div class="absolute inset-0 hidden bg-gradient-to-r from-bg from-12% via-bg/80 via-52% to-bg/10 lg:block"></div>
    <div class="absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-bg/85 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-bg to-transparent"></div>
  </div>

  <div class="container-brand relative">
    <p class="text-eyebrow flex items-center gap-2.5 text-brand-orange">
      <span class="h-px w-6 bg-brand-orange" aria-hidden="true"></span>
      {eyebrow}
    </p>

    <h1 class="mt-6 max-w-3xl text-6xl">{titulo}</h1>

    <p class="mt-6 max-w-xl text-lg text-fg-muted">{descripcion}</p>

    <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
      <EnlaceBoton href="/contacto" tamano="lg">
        Solicitar presupuesto
        <ArrowRight className="h-4 w-4" aria-hidden="true" />
      </EnlaceBoton>
      <EnlaceBoton href={hrefWhatsApp(mensajeWhatsApp)} variante="secundario" tamano="lg">
        <MessageCircle className="h-4 w-4" aria-hidden="true" />
        WhatsApp
      </EnlaceBoton>
    </div>

    {
      conBarraConfianza ? (
        <ul class="hairline-t mt-12 flex flex-wrap items-center gap-x-6 gap-y-2.5 pt-6">
          {barraConfianza.map((item) => (
            <li class="text-eyebrow flex items-center gap-2 text-fg-dim">
              <span class="h-1 w-1 rounded-full bg-n-500" aria-hidden="true" />
              {item}
            </li>
          ))}
        </ul>
      ) : null
    }
  </div>
</section>
