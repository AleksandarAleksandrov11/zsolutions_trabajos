---
import SectionHeading from "@/components/ui/SectionHeading.astro";
import RevealGroup from "@/components/ui/RevealGroup.astro";
import RevealItem from "@/components/ui/RevealItem.astro";
import {
  certificacionesPorGrupo,
  gruposCertificacion,
  type GrupoCertificacion,
} from "@/content/certificaciones";
import { secciones } from "@/content/secciones";
import { CertIcon } from "@/components/ui/CertIcon";

/* Alterna azul y naranja por grupo, no por certificado suelto: así cada
   bloque se lee como una unidad de color y el conjunto no queda moteado. */
const colorPorGrupo: Record<GrupoCertificacion, "azul" | "naranja"> = {
  oficiales: "azul",
  tecnica: "naranja",
  seguridad: "azul",
  verticales: "naranja",
  maquinaria: "azul",
};

type Props = {
  numero?: string;
  /** En Sobre Alex se muestra con el detalle de cada acreditación. */
  detallado?: boolean;
  titulo?: string;
  descripcion?: string;
};

const {
  numero = "06",
  detallado = false,
  titulo = secciones.acreditaciones.titulo,
  descripcion = secciones.acreditaciones.descripcion,
} = Astro.props;
---

<section id="certificaciones" class="py-section" aria-labelledby="titulo-certificaciones">
  <div class="container-brand">
    <SectionHeading
      numero={numero}
      eyebrow={secciones.acreditaciones.eyebrow}
      tituloId="titulo-certificaciones"
      titulo={titulo}
      descripcion={descripcion}
    />

    <div class="mt-12 flex flex-col gap-10">
      {
        gruposCertificacion.map((grupo) => (
          <div>
            <h3 class="text-eyebrow mb-4 text-fg-dim">{grupo.titulo}</h3>

            <RevealGroup
              as="ul"
              stagger={0.04}
              class:list={[
                "grid gap-3",
                detallado ? "sm:grid-cols-2 lg:grid-cols-3" : "sm:grid-cols-2 lg:grid-cols-4",
              ]}
            >
              {certificacionesPorGrupo(grupo.id).map((c) => (
                <RevealItem
                  as="li"
                  class="tarjeta group/carnet flex flex-col gap-3 p-5"
                  tabindex={detallado ? undefined : 0}
                >
                  <span
                    class:list={[
                      "chip-icono h-10 w-10",
                      colorPorGrupo[grupo.id] === "naranja" && "chip-icono-naranja",
                    ]}
                  >
                    <CertIcon nombre={c.icono} className="h-5 w-5" />
                  </span>
                  <span class="font-display text-xs tracking-wider text-fg">
                    {c.siglas}
                  </span>
                  <span class="text-sm font-bold">{c.nombre}</span>
                  {detallado ? (
                    <span class="mt-1 text-xs leading-relaxed text-fg-dim">{c.detalle}</span>
                  ) : (
                    /* En el muro compacto, qué habilita cada carnet se
                       despliega al pasar por encima o al enfocar con el
                       teclado. La tarjeta es enfocable justamente para eso. */
                    <span class="detalle-carnet text-xs leading-relaxed text-fg-dim">
                      <span class="min-h-0">{c.detalle}</span>
                    </span>
                  )}
                </RevealItem>
              ))}
            </RevealGroup>
          </div>
        ))
      }
    </div>
  </div>
</section>
