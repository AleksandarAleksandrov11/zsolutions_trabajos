---
import SectionHeading from "@/components/ui/SectionHeading.astro";
import RevealGroup from "@/components/ui/RevealGroup.astro";
import RevealItem from "@/components/ui/RevealItem.astro";
import {
  certificacionesPorGrupo,
  gruposCertificacion,
} from "@/content/certificaciones";

type Props = {
  numero?: string;
  /** En Sobre Alex se muestra con el detalle de cada acreditación. */
  detallado?: boolean;
  titulo?: string;
  descripcion?: string;
};

const {
  numero = "06",
  detallado = false,
  titulo = "Certificaciones y habilitaciones",
  descripcion = "Las habilitaciones oficiales no son un adorno del presupuesto: son lo que permite ejecutar, firmar y legalizar una instalación.",
} = Astro.props;
---

<section id="certificaciones" class="py-section" aria-labelledby="titulo-certificaciones">
  <div class="container-brand">
    <SectionHeading
      numero={numero}
      eyebrow="Acreditaciones"
      tituloId="titulo-certificaciones"
      titulo={titulo}
      descripcion={descripcion}
    />

    <div class="mt-12 flex flex-col gap-10">
      {
        gruposCertificacion.map((grupo) => (
          <div>
            <h3 class="text-eyebrow mb-4 text-fg-dim">{grupo.titulo}</h3>

            <RevealGroup
              as="ul"
              stagger={0.04}
              class:list={[
                "grid gap-3",
                detallado ? "sm:grid-cols-2 lg:grid-cols-3" : "sm:grid-cols-2 lg:grid-cols-4",
              ]}
            >
              {certificacionesPorGrupo(grupo.id).map((c) => (
                <RevealItem as="li" class="tarjeta flex flex-col gap-1.5 p-5">
                  <span class="font-display text-xs tracking-wider text-fg">
                    {c.siglas}
                  </span>
                  <span class="text-sm font-bold">{c.nombre}</span>
                  {detallado ? (
                    <span class="mt-1 text-xs leading-relaxed text-fg-dim">{c.detalle}</span>
                  ) : null}
                </RevealItem>
              ))}
            </RevealGroup>
          </div>
        ))
      }
    </div>
  </div>
</section>
