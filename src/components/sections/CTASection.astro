---
import { ArrowRight, MessageCircle, Phone } from "lucide-react";
import EnlaceBoton from "@/components/ui/EnlaceBoton.astro";
import Reveal from "@/components/ui/Reveal.astro";
import { hrefTelefono, hrefWhatsApp, mensajeWhatsApp, site } from "@/content/site";

type Props = { titulo?: string; descripcion?: string };

const {
  titulo = "Cuéntame qué necesitas",
  descripcion = `Respondo en ${site.respuesta} con una primera valoración. Sin coste y sin compromiso. Si el trabajo no me corresponde, también te lo diré.`,
} = Astro.props;
---

{/* El único bloque de marca a sangre de cada página: es aquí donde el azul
    corporativo funciona como superficie y no como tinte del gris. También es
    el único sitio de la página donde el botón principal va en naranja. */}
<section class="seccion-azul relative overflow-hidden py-section" aria-labelledby="titulo-cta">
  <div class="plano absolute inset-0 opacity-40" aria-hidden="true"></div>
  <div class="container-brand relative">
    <Reveal>
      <div>
        <div class="max-w-xl">
          <h2 id="titulo-cta" class="text-4xl">{titulo}</h2>
          <p class="mt-4 text-lg text-fg-muted">{descripcion}</p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
            <EnlaceBoton href="/contacto" data-evento="presupuesto_cta" variante="acento" tamano="lg">
              Solicitar presupuesto
              <ArrowRight className="h-4 w-4" aria-hidden="true" />
            </EnlaceBoton>
            <EnlaceBoton
              href={hrefWhatsApp(mensajeWhatsApp)}
              variante="secundario"
              tamano="lg"
            >
              <MessageCircle className="h-4 w-4" aria-hidden="true" />
              WhatsApp
            </EnlaceBoton>
            <EnlaceBoton href={hrefTelefono()} variante="fantasma" tamano="lg">
              <Phone className="h-4 w-4" aria-hidden="true" />
              {site.nap.telefono}
            </EnlaceBoton>
          </div>
        </div>
      </div>
    </Reveal>
  </div>
</section>
