---
import BotonCookies from "@/components/ui/BotonCookies.astro";
import { categoriasCookies } from "@/content/legal";
---

<section id="detalle-por-categorias" class="scroll-mt-28">
  <h2 class="text-2xl">Detalle por categorías</h2>

  <div class="mt-5 flex flex-col gap-5">
    {
      categoriasCookies.map((categoria) => (
        <div class="tarjeta p-6">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h3 class="text-xl">{categoria.titulo}</h3>
            <span class="text-eyebrow text-fg-dim">
              {categoria.siempreActiva ? "Siempre activas" : "Requiere consentimiento"}
            </span>
          </div>
          <p class="mt-3 text-sm text-fg-muted">{categoria.descripcion}</p>

          {/* La tabla desborda dentro de su contenedor, nunca en la página. */}
          <div class="-mx-2 mt-5 overflow-x-auto px-2">
            <table class="w-full min-w-[32rem] border-collapse text-left text-sm">
              <caption class="sr-only">
                Elementos almacenados en la categoría {categoria.titulo}
              </caption>
              <thead>
                <tr class="hairline-b">
                  <th scope="col" class="text-eyebrow py-2.5 pr-4 text-fg-dim">Nombre</th>
                  <th scope="col" class="text-eyebrow py-2.5 pr-4 text-fg-dim">Finalidad</th>
                  <th scope="col" class="text-eyebrow py-2.5 text-fg-dim">Duración</th>
                </tr>
              </thead>
              <tbody>
                {categoria.ejemplos.map((ejemplo) => (
                  <tr class="hairline-b">
                    <td class="py-3 pr-4 align-top font-display text-xs text-brand-blue-soft">
                      {ejemplo.nombre}
                    </td>
                    <td class="py-3 pr-4 align-top text-fg-muted">{ejemplo.finalidad}</td>
                    <td class="whitespace-nowrap py-3 align-top text-fg-muted">
                      {ejemplo.duracion}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))
    }
  </div>

  <div class="tarjeta mt-6 p-6">
    <h3 class="text-xl">Cambiar mi decisión</h3>
    <p class="mt-3 text-sm text-fg-muted">
      Puedes revisar o modificar tu elección cuando quieras. Se guarda 12 meses.
    </p>
    <div class="hairline mt-5 inline-flex min-h-11 items-center rounded-full px-4 text-sm">
      <BotonCookies />
    </div>
  </div>
</section>
