---
import BotonCookies from "@/components/ui/BotonCookies.astro";
import { categoriasCookies } from "@/content/legal";
---

<section id="detalle-por-categorias" class="scroll-mt-32">
  <h2 class="text-2xl">Detalle por categorías</h2>

  <div class="mt-6 flex flex-col gap-6">
    {
      categoriasCookies.map((categoria) => (
        <div class="rounded-[2px] border border-white/10 bg-surface/40 p-6">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h3 class="text-xl">{categoria.titulo}</h3>
            <span class="text-eyebrow text-brand-orange">
              {categoria.siempreActiva ? "Siempre activas" : "Requiere consentimiento"}
            </span>
          </div>
          <p class="mt-3 text-sm text-fg-muted">{categoria.descripcion}</p>

          {/* La tabla desborda en horizontal dentro de su contenedor, nunca la página */}
          <div class="mt-5 -mx-2 overflow-x-auto px-2">
            <table class="w-full min-w-[34rem] border-collapse text-left text-sm">
              <caption class="sr-only">
                Elementos almacenados en la categoría {categoria.titulo}
              </caption>
              <thead>
                <tr class="border-b border-white/12">
                  <th scope="col" class="text-eyebrow py-2.5 pr-4 text-fg-muted/50">
                    Nombre
                  </th>
                  <th scope="col" class="text-eyebrow py-2.5 pr-4 text-fg-muted/50">
                    Finalidad
                  </th>
                  <th scope="col" class="text-eyebrow py-2.5 text-fg-muted/50">
                    Duración
                  </th>
                </tr>
              </thead>
              <tbody>
                {categoria.ejemplos.map((ejemplo) => (
                  <tr class="border-b border-white/8">
                    <td class="py-3 pr-4 align-top font-display text-xs text-brand-blue">
                      {ejemplo.nombre}
                    </td>
                    <td class="py-3 pr-4 align-top text-fg-muted">{ejemplo.finalidad}</td>
                    <td class="whitespace-nowrap py-3 align-top text-fg-muted">
                      {ejemplo.duracion}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))
    }
  </div>

  <div class="mt-8 rounded-[2px] border border-brand-blue/40 bg-brand-blue-deep/25 p-6">
    <h3 class="text-xl">Cambiar mi decisión</h3>
    <p class="mt-3 text-sm text-fg-muted">
      Puedes revisar o modificar tu elección cuando quieras. Se guarda 12 meses.
    </p>
    <div
      class="mt-5 inline-flex min-h-11 items-center rounded-[2px] border border-white/25 px-4 text-sm transition-colors hover:border-white/60"
    >
      <BotonCookies />
    </div>
  </div>
</section>
