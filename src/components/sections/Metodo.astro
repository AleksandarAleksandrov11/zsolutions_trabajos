---
import SectionHeading from "@/components/ui/SectionHeading.astro";
import RevealGroup from "@/components/ui/RevealGroup.astro";
import RevealItem from "@/components/ui/RevealItem.astro";
import { secciones } from "@/content/secciones";

/* `tema` decide el fondo del bloque. En la portada va en azul, que es donde el
   corporativo funciona como superficie. En `/servicios` cae justo encima del
   cierre, y dos franjas azules seguidas se comen la página, así que allí va
   en el tono alterno. */
type Props = { numero?: string; tema?: "azul" | "alterna" };
const { numero = "02", tema = "azul" } = Astro.props;

const argumentos = [
  {
    titulo: "Instalador certificado, no intermediario",
    detalle:
      "Quien te visita, quien presupuesta y quien firma la instalación es la misma persona. Nada se vende para colocárselo después a un tercero.",
  },
  {
    titulo: "Presupuesto en menos de 24 horas",
    detalle:
      "Respondo con una primera valoración en menos de un día, y si hace falta visita, la concreto en esa misma respuesta. Sin coste y sin compromiso.",
  },
  {
    titulo: "Trabajo documentado y certificado",
    detalle:
      "Certificado eléctrico, esquema unifilar, documentación RITE o registro de carga de refrigerante, según el trabajo. Documentar entra en el precio.",
  },
  {
    titulo: "Un único interlocutor",
    detalle:
      "Sin centralita y sin comerciales. Si algo se desvía de lo previsto, te lo cuento antes de ejecutarlo, no en la factura.",
  },
];
---

<section class:list={[tema === "azul" ? "seccion-azul" : "seccion-alterna", "py-section"]} aria-labelledby="titulo-metodo">
  <div class="container-brand">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1fr)] lg:gap-20">
      <SectionHeading
        numero={numero}
        eyebrow={secciones.metodo.eyebrow}
        tituloId="titulo-metodo"
        titulo={secciones.metodo.titulo}
        class="lg:sticky lg:top-28 lg:self-start"
      />

      <RevealGroup as="ul" class="flex flex-col" stagger={0.07}>
        {
          argumentos.map((argumento, i) => (
            <RevealItem as="li" class="hairline-b py-7 first:pt-0">
              <div class="flex gap-5">
                <span class="num-seccion shrink-0 pt-1.5">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div>
                  <h3 class="text-xl">{argumento.titulo}</h3>
                  <p class="mt-2 text-fg-muted">{argumento.detalle}</p>
                </div>
              </div>
            </RevealItem>
          ))
        }
      </RevealGroup>
    </div>
  </div>
</section>
