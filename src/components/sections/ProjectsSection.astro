---
import { ArrowRight } from "lucide-react";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import EnlaceBoton from "@/components/ui/EnlaceBoton.astro";
import Reveal from "@/components/ui/Reveal.astro";
import RevealGroup from "@/components/ui/RevealGroup.astro";
import RevealItem from "@/components/ui/RevealItem.astro";
import MediaPlaceholder from "@/components/ui/MediaPlaceholder.astro";
import TarjetaProyecto from "@/components/sections/TarjetaProyecto.astro";
import { proyectos } from "@/content/proyectos";

type Props = { numero?: string };
const { numero = "05" } = Astro.props;

const destacados = proyectos.filter((p) => p.destacado).slice(0, 3);
---

<section class="py-section" aria-labelledby="titulo-proyectos">
  <div class="container-brand">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
      <SectionHeading
        numero={numero}
        eyebrow="Trabajos"
        tituloId="titulo-proyectos"
        titulo="Obra real, no catálogo"
        descripcion="Cada trabajo con su reto, su solución y su ubicación. Sin fotos de banco de imágenes y sin proyectos de otros."
      />
      <EnlaceBoton href="/proyectos" variante="secundario" class="shrink-0">
        Ver la galería
        <ArrowRight className="h-4 w-4" aria-hidden="true" />
      </EnlaceBoton>
    </div>

    {
      destacados.length > 0 ? (
        <RevealGroup class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {destacados.map((proyecto) => (
            <RevealItem>
              <a href={`/proyectos#${proyecto.slug}`}>
                <TarjetaProyecto proyecto={proyecto} />
              </a>
            </RevealItem>
          ))}
        </RevealGroup>
      ) : (
        <Reveal class="mt-14">
          <div class="grid gap-6 md:grid-cols-3">
            <MediaPlaceholder
              descripcion="Instalación eléctrica o cuadro terminado. Foto del trabajo acabado."
              medidas="1600 × 1200 px · 4:3"
              ratio="4 / 3"
            />
            <MediaPlaceholder
              descripcion="Trabajo vertical en fachada o espacio confinado, con el equipo puesto."
              medidas="1600 × 1200 px · 4:3"
              ratio="4 / 3"
            />
            <MediaPlaceholder
              descripcion="Instalación de climatización o aerotermia terminada."
              medidas="1600 × 1200 px · 4:3"
              ratio="4 / 3"
            />
          </div>
          <p class="mt-6 max-w-2xl text-sm text-fg-muted/70">
            La galería está montada y funcionando: filtros por servicio y por zona,
            retícula y visor con navegación por teclado. Falta el contenido real, que no
            se inventa. En cuanto haya fotos y datos de trabajos ejecutados, se publican
            solos.
          </p>
        </Reveal>
      )
    }
  </div>
</section>
