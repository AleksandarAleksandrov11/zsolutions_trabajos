---
import { Quote } from "lucide-react";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Reveal from "@/components/ui/Reveal.astro";
import { testimonios } from "@/content/testimonios";
import { secciones } from "@/content/secciones";

type Props = { numero?: string };
const { numero = "05" } = Astro.props;

/*
 * Cinta de testimonios.
 *
 * Se mueve sola, igual que la cinta de confianza del héroe: mismo mecanismo
 * de CSS (contenido duplicado, la pista se desplaza un 100 % y vuelve a
 * empezar sin que se note el salto), sin botones de pausa ni flechas. Se
 * para al pasar el ratón por encima o al enfocar dentro con el teclado, y
 * con `prefers-reduced-motion` se queda quieta.
 *
 * Es una de las dos secciones claras de la web: corta el bloque oscuro
 * continuo justo donde el contenido cambia de registro, de lo que cuenta
 * Alex a lo que cuentan sus clientes.
 *
 * ⚠️ Los textos son de ejemplo (ver `src/content/testimonios.ts`). Por eso NO
 * se emite `Review` ni `AggregateRating` en el JSON-LD de ninguna página.
 */

/* La inicial del nombre hace de retrato mientras no haya fotos reales. */
const inicial = (autor: string) => autor.trim().charAt(0).toUpperCase();
---

{
  testimonios.length > 0 ? (
    <section class="seccion-clara py-section" aria-labelledby="titulo-testimonios">
      <div class="container-brand">
        <SectionHeading
          numero={numero}
          eyebrow={secciones.testimonios.eyebrow}
          tituloId="titulo-testimonios"
          titulo={secciones.testimonios.titulo}
          class="max-w-xl"
        />
      </div>

      <Reveal class="mt-12">
        <div
          class="cinta-testimonios"
          style="--cinta-duracion: 55s"
          role="group"
          aria-label="Testimonios de clientes"
        >
          {[0, 1].map((copia) => (
            <div class="cinta-testimonios-pista" aria-hidden={copia === 1 ? "true" : undefined}>
              {testimonios.map((t) => (
                <article class="tarjeta flex w-[19rem] shrink-0 flex-col p-6 sm:w-[21rem] sm:p-7">
                  <div class="flex items-center gap-3">
                    <span class="chip-icono h-11 w-11 font-display text-lg" aria-hidden="true">
                      {inicial(t.autor)}
                    </span>
                    <span>
                      <span class="block text-sm font-bold">{t.autor}</span>
                      <span class="block text-xs text-fg-dim">{t.lugar}</span>
                    </span>
                  </div>

                  <Quote className="mt-6 h-5 w-5 shrink-0 text-brand-blue" aria-hidden="true" />
                  <blockquote class="mt-3 flex-1 text-fg-muted">{t.texto}</blockquote>

                  <footer class="hairline-t mt-6 pt-4">
                    <p class="text-eyebrow text-fg-dim">{t.trabajo}</p>
                  </footer>
                </article>
              ))}
            </div>
          ))}
        </div>
      </Reveal>
    </section>
  ) : null
}
