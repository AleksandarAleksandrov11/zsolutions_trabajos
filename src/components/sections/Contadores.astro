---
import RevealGroup from "@/components/ui/RevealGroup.astro";
import RevealItem from "@/components/ui/RevealItem.astro";
import AnimatedCounter from "@/components/ui/AnimatedCounter.astro";
import { cifras, type Cifra } from "@/content/cifras";

type Props = {
  /** Por defecto salen las cuatro. */
  lista?: Cifra[];
  class?: string;
};

const { lista = cifras, class: clase } = Astro.props;

/**
 * Muro de cifras.
 *
 * La cifra sube desde cero al entrar en pantalla, una sola vez, y el número
 * final ya está escrito en el HTML: si el JavaScript no llega, se lee igual.
 */
---

<RevealGroup
  as="div"
  class:list={["grid gap-4 sm:grid-cols-2 lg:grid-cols-4", clase]}
  stagger={0.06}
>
  {
    lista.map((cifra) => (
      <RevealItem class="tarjeta flex h-full flex-col p-6">
        {/* En el DOM va primero el `<dt>`, que es lo que exige una lista de
            definición; la cifra se pinta encima con `order`. Al revés el
            marcado es inválido y los lectores de pantalla se pierden. */}
        <dl class="flex flex-col">
          <dt class="text-eyebrow order-2 mt-2 text-fg">{cifra.etiqueta}</dt>
          <dd class="font-display order-1 text-4xl text-brand-orange">
            <AnimatedCounter valor={cifra.valor} sufijo={cifra.sufijo} />
          </dd>
        </dl>
        <p class="mt-2 text-sm text-fg-dim">{cifra.detalle}</p>
      </RevealItem>
    ))
  }
</RevealGroup>
