---
import SectionHeading from "@/components/ui/SectionHeading.astro";
import RevealGroup from "@/components/ui/RevealGroup.astro";
import RevealItem from "@/components/ui/RevealItem.astro";
import type { PasoProceso } from "@/content/servicios";
import { secciones } from "@/content/secciones";

type Props = { pasos: PasoProceso[]; numero?: string; titulo?: string };
const { pasos, numero = "03", titulo = "Cómo trabajo" } = Astro.props;
---

<section class="seccion-azul py-section" aria-labelledby="titulo-proceso">
  <div class="container-brand">
    <SectionHeading
      numero={numero}
      eyebrow={secciones.proceso.eyebrow}
      tituloId="titulo-proceso"
      titulo={titulo}
      descripcion={secciones.proceso.descripcion}
    />

    <RevealGroup
      as="ol"
      class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4"
      stagger={0.06}
    >
      {
        pasos.map((paso) => (
          <RevealItem as="li" class="tarjeta flex flex-col gap-3 p-6">
            <span class="num-seccion">{paso.paso}</span>
            <h3 class="text-xl">{paso.titulo}</h3>
            <p class="text-sm text-fg-muted">{paso.detalle}</p>
          </RevealItem>
        ))
      }
    </RevealGroup>
  </div>
</section>
