---
import { Plus } from "lucide-react";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import type { ParFaq } from "@/content/servicios";
import { slugify } from "@/lib/utils";

type Props = {
  preguntas: ParFaq[];
  numero?: string;
  titulo?: string;
  eyebrow?: string;
};

const {
  preguntas,
  numero = "07",
  titulo = "Preguntas frecuentes",
  eyebrow = "Dudas habituales",
} = Astro.props;

/* Acordeón con `<details>` nativo: accesible por teclado sin JavaScript. */
const idTitulo = `faq-${slugify(titulo)}`;
---

<section class="py-section" aria-labelledby={idTitulo}>
  <div class="container-brand">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1fr)] lg:gap-20">
      <SectionHeading
        numero={numero}
        eyebrow={eyebrow}
        tituloId={idTitulo}
        titulo={titulo}
        class="lg:sticky lg:top-28 lg:self-start"
      />

      <div>
        {
          preguntas.map((par, i) => (
            <details class="faq-item group hairline-b" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 transition-colors hover:text-brand-blue-soft">
                <h3 class="font-sans text-lg font-bold">{par.p}</h3>
                <span
                  class="mt-1 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white/[0.06] text-brand-blue-soft transition-transform duration-300 group-open:rotate-45"
                  aria-hidden="true"
                >
                  <Plus className="h-3.5 w-3.5" />
                </span>
              </summary>
              <div class="respuesta-faq">
                <p class="pb-6 text-fg-muted lg:pr-10">{par.r}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
