---
import Breadcrumbs, { type Miga } from "@/components/ui/Breadcrumbs.astro";
import Badge from "@/components/ui/Badge.astro";
import Reveal from "@/components/ui/Reveal.astro";
import {
  avisoRevisionLegal,
  datosFiscales,
  encargadosTratamiento,
  type SeccionLegal,
} from "@/content/legal";
import { site } from "@/content/site";
import { DOMINIO_ACTUAL } from "@/lib/seo";

type Props = {
  titulo: string;
  entradilla: string;
  actualizado: string;
  secciones: SeccionLegal[];
  migas: Miga[];
  /** Muestra la ficha de datos del titular bajo la primera sección. */
  conFichaTitular?: boolean;
  /** Muestra la tabla de encargados del tratamiento. */
  conEncargados?: boolean;
};

const {
  titulo,
  entradilla,
  actualizado,
  secciones,
  migas,
  conFichaTitular = false,
  conEncargados = false,
} = Astro.props;

function slugSeccion(texto: string): string {
  return texto
    .toLowerCase()
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
}

const titular: { etiqueta: string; valor: string | null }[] = [
  { etiqueta: "Titular", valor: datosFiscales.titular },
  { etiqueta: "NIF / CIF", valor: datosFiscales.nif },
  { etiqueta: "Domicilio", valor: datosFiscales.domicilio },
  { etiqueta: "Email", valor: datosFiscales.email },
  { etiqueta: "Teléfono", valor: datosFiscales.telefono },
  { etiqueta: "Nombre comercial", valor: datosFiscales.nombreComercial },
  { etiqueta: "Dominio", valor: DOMINIO_ACTUAL },
  { etiqueta: "Actividad", valor: datosFiscales.actividad },
  { etiqueta: "Registro", valor: datosFiscales.registro },
];
---

<header class="pt-36 pb-10 md:pt-44">
  <div class="container-brand">
    <Breadcrumbs migas={migas} />
    <p class="text-eyebrow mt-8 mb-5 text-brand-orange">Información legal</p>
    <h1 class="max-w-3xl text-5xl">{titulo}</h1>
    <p class="mt-6 max-w-2xl text-lg text-fg-muted">{entradilla}</p>
    <p class="mt-6 text-sm text-fg-muted/60">
      Última actualización:{" "}
      {
        actualizado.startsWith("TODO") ? (
          <Badge tono="pendiente">{actualizado}</Badge>
        ) : (
          actualizado
        )
      }
    </p>
  </div>
</header>

<section class="pb-section">
  <div class="container-brand">
    <Reveal class="rounded-[2px] border border-brand-orange/35 bg-brand-orange/[0.07] p-5">
      <p class="text-sm text-fg-muted">
        <strong class="text-brand-orange">Nota para Alex.</strong>{" "}{avisoRevisionLegal}
      </p>
    </Reveal>

    <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,0.28fr)_minmax(0,1fr)] lg:gap-16">
      {/* Índice */}
      <nav aria-label="Índice del documento" class="lg:sticky lg:top-32 lg:self-start">
        <h2 class="text-eyebrow mb-4 text-fg-muted/50">Contenido</h2>
        <ol class="flex flex-col border-l border-white/10 pl-4 text-sm">
          {
            secciones.map((seccion) => (
              <li>
                <a
                  href={`#${slugSeccion(seccion.titulo)}`}
                  class="flex min-h-11 items-center text-fg-muted transition-colors hover:text-fg"
                >
                  {seccion.titulo}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div>
        {
          conFichaTitular ? (
            <div class="mb-12 rounded-[2px] border border-white/10 bg-surface/40 p-6">
              <h2 class="text-eyebrow mb-5 text-fg-muted/50">Datos del titular</h2>
              <dl>
                {titular.map((dato) => (
                  <div class="flex flex-col gap-1 border-b border-white/10 py-3 sm:flex-row sm:gap-6 sm:py-2.5">
                    <dt class="text-eyebrow shrink-0 pt-1 text-fg-muted/50 sm:w-52">
                      {dato.etiqueta}
                    </dt>
                    <dd class="text-sm text-fg">
                      {dato.valor ?? <Badge tono="pendiente">TODO · lo aporta Alex</Badge>}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          ) : null
        }

        <div class="flex flex-col gap-10">
          {
            secciones.map((seccion) => (
              <section id={slugSeccion(seccion.titulo)} class="scroll-mt-32">
                <h2 class="text-2xl">{seccion.titulo}</h2>
                {seccion.parrafos ? (
                  <div class="prosa mt-4">
                    {seccion.parrafos.map((parrafo) => (
                      <p>{parrafo}</p>
                    ))}
                  </div>
                ) : null}
                {seccion.lista ? (
                  <ul class="mt-4 flex flex-col gap-2.5">
                    {seccion.lista.map((item) => (
                      <li class="flex items-start gap-3 text-fg-muted">
                        <span
                          class="mt-2.5 h-1.5 w-1.5 shrink-0 bg-brand-blue"
                          aria-hidden="true"
                        />
                        {item}
                      </li>
                    ))}
                  </ul>
                ) : null}
              </section>
            ))
          }

          {
            conEncargados ? (
              <section id="encargados" class="scroll-mt-32">
                <h2 class="text-2xl">Encargados del tratamiento</h2>
                <ul class="mt-4 flex flex-col gap-3">
                  {encargadosTratamiento.map((encargado) => (
                    <li class="rounded-[2px] border border-white/10 bg-surface/40 p-5">
                      <p class="font-bold">{encargado.nombre}</p>
                      <p class="mt-2 text-sm text-fg-muted">{encargado.finalidad}</p>
                      <p class="mt-1 text-xs text-fg-muted/60">{encargado.ubicacion}</p>
                    </li>
                  ))}
                </ul>
              </section>
            ) : null
          }

          <slot />

          <p class="border-t border-white/10 pt-8 text-sm text-fg-muted/60">
            {site.nombre} · {site.nap.ciudad}, {site.nap.comunidad}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
