---
import Breadcrumbs, { type Miga } from "@/components/ui/Breadcrumbs.astro";
import {
  datosFiscales,
  encargadosTratamiento,
  type SeccionLegal,
} from "@/content/legal";
import { site } from "@/content/site";
import { DOMINIO_ACTUAL } from "@/lib/seo";

type Props = {
  titulo: string;
  entradilla: string;
  actualizado: string;
  secciones: SeccionLegal[];
  migas: Miga[];
  /** Muestra la ficha de datos del titular. */
  conFichaTitular?: boolean;
  /** Muestra la tabla de encargados del tratamiento. */
  conEncargados?: boolean;
};

const {
  titulo,
  entradilla,
  actualizado,
  secciones,
  migas,
  conFichaTitular = false,
  conEncargados = false,
} = Astro.props;

function slugSeccion(texto: string): string {
  return texto
    .toLowerCase()
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
}

const titular: { etiqueta: string; valor: string }[] = [
  { etiqueta: "Titular", valor: datosFiscales.titular },
  { etiqueta: "NIF", valor: datosFiscales.nif },
  { etiqueta: "Domicilio", valor: datosFiscales.domicilio },
  { etiqueta: "Email", valor: datosFiscales.email },
  { etiqueta: "Teléfono", valor: datosFiscales.telefono },
  { etiqueta: "Nombre comercial", valor: datosFiscales.nombreComercial },
  { etiqueta: "Dominio", valor: DOMINIO_ACTUAL },
  { etiqueta: "Actividad", valor: datosFiscales.actividad },
  { etiqueta: "Registro", valor: datosFiscales.registro },
];
---

<header class="pt-32 pb-10 sm:pt-40">
  <div class="container-brand">
    <Breadcrumbs migas={migas} />
    <h1 class="mt-7 max-w-3xl text-5xl">{titulo}</h1>
    <p class="mt-5 max-w-2xl text-lg text-fg-muted">{entradilla}</p>
    <p class="mt-5 text-sm text-fg-dim">Última actualización: {actualizado}</p>
  </div>
</header>

<section class="pb-section">
  <div class="container-brand">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.3fr)_minmax(0,1fr)] lg:gap-16">
      {/* Índice */}
      <nav aria-label="Índice del documento" class="lg:sticky lg:top-28 lg:self-start">
        <h2 class="text-eyebrow mb-3 text-fg-dim">Contenido</h2>
        <ol class="hairline-l flex flex-col border-l border-line pl-4 text-sm">
          {
            secciones.map((seccion) => (
              <li>
                <a
                  href={`#${slugSeccion(seccion.titulo)}`}
                  class="flex min-h-11 items-center text-fg-muted transition-colors hover:text-fg"
                >
                  {seccion.titulo}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div>
        {
          conFichaTitular ? (
            <div class="tarjeta mb-10 p-6">
              <h2 class="text-eyebrow mb-4 text-fg-dim">Datos del titular</h2>
              <dl>
                {titular.map((dato) => (
                  <div class="hairline-b flex flex-col gap-1 py-3 sm:flex-row sm:gap-6">
                    <dt class="text-eyebrow shrink-0 pt-1 text-fg-dim sm:w-44">
                      {dato.etiqueta}
                    </dt>
                    <dd class="text-sm">{dato.valor}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ) : null
        }

        <div class="flex flex-col gap-9">
          {
            secciones.map((seccion) => (
              <section id={slugSeccion(seccion.titulo)} class="scroll-mt-28">
                <h2 class="text-2xl">{seccion.titulo}</h2>
                {seccion.parrafos ? (
                  <div class="prosa mt-3">
                    {seccion.parrafos.map((parrafo) => (
                      <p>{parrafo}</p>
                    ))}
                  </div>
                ) : null}
                {seccion.lista ? (
                  <ul class="mt-3 flex flex-col gap-2">
                    {seccion.lista.map((item) => (
                      <li class="flex items-start gap-3 text-fg-muted">
                        <span
                          class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-brand-blue-soft"
                          aria-hidden="true"
                        />
                        {item}
                      </li>
                    ))}
                  </ul>
                ) : null}
              </section>
            ))
          }

          {
            conEncargados ? (
              <section id="encargados" class="scroll-mt-28">
                <h2 class="text-2xl">Encargados del tratamiento</h2>
                <ul class="mt-4 flex flex-col gap-3">
                  {encargadosTratamiento.map((e) => (
                    <li class="tarjeta p-5">
                      <p class="font-bold">{e.nombre}</p>
                      <p class="mt-2 text-sm text-fg-muted">{e.finalidad}</p>
                      <p class="mt-1 text-xs text-fg-dim">{e.ubicacion}</p>
                    </li>
                  ))}
                </ul>
              </section>
            ) : null
          }

          <slot />

          <p class="hairline-t pt-6 text-sm text-fg-dim">
            {site.nap.razonSocial} · {site.nap.ciudad}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
