---
import { Mail, MapPin, Phone } from "lucide-react";
import { SocialIcon } from "@/components/ui/SocialIcon";
import BrandLogo from "@/components/ui/BrandLogo.astro";
import Badge from "@/components/ui/Badge.astro";
import BotonCookies from "@/components/ui/BotonCookies.astro";
import {
  hrefEmail,
  hrefTelefono,
  navLegal,
  navPrincipal,
  site,
  telefonoVisible,
} from "@/content/site";
import { servicios } from "@/content/servicios";
import { zonas } from "@/content/zonas";

const telefono = telefonoVisible();
const anio = new Date().getFullYear();

const redes = [
  { href: site.redes.instagram, red: "instagram" as const, etiqueta: "Instagram de Alex Zsurzs" },
  { href: site.redes.tiktok, red: "tiktok" as const, etiqueta: "TikTok de Alex Zsurzs" },
  { href: site.redes.youtube, red: "youtube" as const, etiqueta: "YouTube de Alex Zsurzs" },
];
---

<footer class="relative border-t border-white/10 bg-surface/40">
  <div class="rayas-z absolute inset-x-0 top-0 h-1 opacity-60" aria-hidden="true"></div>

  <div class="container-brand py-16 md:py-20">
    <div
      class="grid gap-12 lg:grid-cols-[minmax(0,1.15fr)_repeat(3,minmax(0,1fr))] lg:gap-8"
    >
      {/* Marca y NAP */}
      <div>
        <BrandLogo variante="horizontal" class="text-fg" conLema />
        <p class="mt-5 max-w-sm text-sm text-fg-muted">{site.descripcionCorta}</p>

        <address class="mt-6 flex flex-col gap-3 text-sm not-italic text-fg-muted">
          <span class="flex items-start gap-3">
            <MapPin className="mt-0.5 h-4 w-4 shrink-0 text-brand-blue" aria-hidden="true" />
            <span>
              {
                site.nap.calle ? (
                  <>
                    {site.nap.calle}
                    <br />
                    {site.nap.codigoPostal} {site.nap.ciudad}, {site.nap.provincia}
                  </>
                ) : (
                  <>
                    {site.nap.ciudad}, {site.nap.comunidad}
                    <br />
                    <Badge tono="pendiente" class="mt-2">TODO · dirección fiscal</Badge>
                  </>
                )
              }
            </span>
          </span>

          <span class="flex items-center gap-3">
            <Phone className="h-4 w-4 shrink-0 text-brand-blue" aria-hidden="true" />
            {
              telefono ? (
                <a href={hrefTelefono()} class="hover:text-fg">
                  {telefono}
                </a>
              ) : (
                <Badge tono="pendiente">TODO · teléfono</Badge>
              )
            }
          </span>

          <span class="flex items-center gap-3">
            <Mail className="h-4 w-4 shrink-0 text-brand-blue" aria-hidden="true" />
            {
              site.nap.email ? (
                <a href={hrefEmail()} class="hover:text-fg">
                  {site.nap.email}
                </a>
              ) : (
                <Badge tono="pendiente">TODO · email</Badge>
              )
            }
          </span>
        </address>

        <div class="mt-6 flex items-center gap-2">
          {
            redes.map((enlace) => (
              <a
                href={enlace.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={enlace.etiqueta}
                class="inline-flex h-11 w-11 items-center justify-center rounded-[2px] border border-white/15 text-fg-muted transition-colors hover:border-brand-blue hover:text-fg"
              >
                <SocialIcon red={enlace.red} />
              </a>
            ))
          }
        </div>
      </div>

      {/* Servicios */}
      <nav aria-label="Servicios">
        <h2 class="text-eyebrow mb-5 text-fg-muted/50">Servicios</h2>
        <ul class="flex flex-col text-sm">
          {
            servicios.map((servicio) => (
              <li>
                <a
                  href={`/servicios/${servicio.slug}`}
                  class="flex min-h-11 items-center text-fg-muted transition-colors hover:text-fg"
                >
                  {servicio.nombre}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Zonas */}
      <nav aria-label="Zonas de actuación">
        <h2 class="text-eyebrow mb-5 text-fg-muted/50">Zonas</h2>
        <ul class="flex flex-col text-sm">
          {
            zonas.slice(0, 9).map((zona) => (
              <li>
                <a
                  href={`/zonas/${zona.slug}`}
                  class="flex min-h-11 items-center text-fg-muted transition-colors hover:text-fg"
                >
                  {zona.ciudad}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="/zonas"
              class="flex min-h-11 items-center text-fg transition-colors hover:text-brand-orange"
            >
              Ver todas las zonas
            </a>
          </li>
        </ul>
      </nav>

      {/* Web y legal */}
      <nav aria-label="Enlaces de la web">
        <h2 class="text-eyebrow mb-5 text-fg-muted/50">Web</h2>
        <ul class="flex flex-col text-sm">
          {
            navPrincipal.map((enlace) => (
              <li>
                <a
                  href={enlace.href}
                  class="flex min-h-11 items-center text-fg-muted transition-colors hover:text-fg"
                >
                  {enlace.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="/contacto"
              class="flex min-h-11 items-center text-fg-muted transition-colors hover:text-fg"
            >
              Contacto
            </a>
          </li>
        </ul>

        <h2 class="text-eyebrow mt-8 mb-5 text-fg-muted/50">Legal</h2>
        <ul class="flex flex-col text-sm">
          {
            navLegal.map((enlace) => (
              <li>
                <a
                  href={enlace.href}
                  class="flex min-h-11 items-center text-fg-muted transition-colors hover:text-fg"
                >
                  {enlace.label}
                </a>
              </li>
            ))
          }
          <li><BotonCookies /></li>
        </ul>
      </nav>
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t border-white/10 pt-8 text-xs text-fg-muted/50 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        © {anio} {site.nombre}{site.nap.razonSocial ? ` · ${site.nap.razonSocial}` : ""} ·
        Instalaciones en {site.nap.ciudad} y {site.nap.comunidad}.
      </p>
      <p>
        Proyecto personal de{" "}
        <a
          href={site.redes.webPersonal}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center hover:text-fg"
        >
          {site.fundador}
        </a>
      </p>
    </div>
  </div>
</footer>
