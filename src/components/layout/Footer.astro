---
import { Mail, MapPin, Phone } from "lucide-react";
import { SocialIcon } from "@/components/ui/SocialIcon";
import BrandLogo from "@/components/ui/BrandLogo.astro";
import BotonCookies from "@/components/ui/BotonCookies.astro";
import {
  hrefEmail,
  hrefTelefono,
  navLegal,
  navPrincipal,
  site,
} from "@/content/site";
import { servicios } from "@/content/servicios";

const anio = new Date().getFullYear();

const redes = [
  { href: site.redes.instagram, red: "instagram" as const, etiqueta: "Instagram de Alex Zsurzs" },
  { href: site.redes.tiktok, red: "tiktok" as const, etiqueta: "TikTok de Alex Zsurzs" },
  { href: site.redes.youtube, red: "youtube" as const, etiqueta: "YouTube de Alex Zsurzs" },
];
---

<footer class="hairline-t mt-auto bg-surface/40">
  <div class="container-brand py-14 md:py-16">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-[minmax(0,1.4fr)_repeat(2,minmax(0,1fr))] lg:gap-10">
      {/* Marca y datos de contacto */}
      <div>
        <BrandLogo class="h-7" alt="" />
        <p class="mt-5 max-w-sm text-sm text-fg-muted">{site.descripcionCorta}</p>

        <address class="mt-6 flex flex-col gap-3 text-sm not-italic text-fg-muted">
          <span class="flex items-start gap-3">
            <MapPin className="mt-0.5 h-4 w-4 shrink-0 text-n-400" aria-hidden="true" />
            <span>
              {site.nap.calle}<br />
              {site.nap.codigoPostal} {site.nap.ciudad}
            </span>
          </span>

          <a href={hrefTelefono()} class="flex min-h-11 items-center gap-3 hover:text-fg">
            <Phone className="h-4 w-4 shrink-0 text-n-400" aria-hidden="true" />
            {site.nap.telefono}
          </a>

          <a href={hrefEmail()} class="flex min-h-11 items-center gap-3 hover:text-fg">
            <Mail className="h-4 w-4 shrink-0 text-n-400" aria-hidden="true" />
            {site.nap.email}
          </a>
        </address>

        <div class="mt-6 flex items-center gap-2">
          {
            redes.map((enlace) => (
              <a
                href={enlace.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={enlace.etiqueta}
                class="hairline inline-flex h-11 w-11 items-center justify-center rounded-full text-fg-dim transition-colors hover:border-fg/35 hover:text-fg"
              >
                <SocialIcon red={enlace.red} />
              </a>
            ))
          }
        </div>
      </div>

      {/* Servicios */}
      <nav aria-label="Servicios">
        <h2 class="text-eyebrow mb-4 text-fg-dim">Servicios</h2>
        <ul class="flex flex-col text-sm">
          {
            servicios.map((servicio) => (
              <li>
                <a
                  href={`/servicios/${servicio.slug}`}
                  class="flex min-h-11 items-center text-fg-muted transition-colors hover:text-fg"
                >
                  {servicio.nombre}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Web y legal */}
      <nav aria-label="Enlaces de la web">
        <h2 class="text-eyebrow mb-4 text-fg-dim">Web</h2>
        <ul class="flex flex-col text-sm">
          {
            [...navPrincipal, { label: "Contacto", href: "/contacto" }].map((enlace) => (
              <li>
                <a
                  href={enlace.href}
                  class="flex min-h-11 items-center text-fg-muted transition-colors hover:text-fg"
                >
                  {enlace.label}
                </a>
              </li>
            ))
          }
        </ul>

        <h2 class="text-eyebrow mt-6 mb-4 text-fg-dim">Legal</h2>
        <ul class="flex flex-col text-sm">
          {
            navLegal.map((enlace) => (
              <li>
                <a
                  href={enlace.href}
                  class="flex min-h-11 items-center text-fg-muted transition-colors hover:text-fg"
                >
                  {enlace.label}
                </a>
              </li>
            ))
          }
          <li><BotonCookies /></li>
        </ul>
      </nav>
    </div>

    <div
      class="hairline-t mt-12 flex flex-col gap-2 pt-8 text-xs text-fg-dim sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {anio} {site.nap.razonSocial} · NIF {site.nap.nif}</p>
      <p>{site.nap.horario}</p>
    </div>
  </div>
</footer>
