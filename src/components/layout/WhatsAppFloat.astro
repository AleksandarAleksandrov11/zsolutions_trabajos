---
import { MessageCircle } from "lucide-react";
import { hrefWhatsApp, mensajeWhatsApp } from "@/content/site";

/**
 * Botón flotante. Aparece tras el primer scroll para no tapar el hero, y en
 * móvil se aparta del formulario cuando este ocupa la pantalla.
 */
---

<a
  id="whatsapp-flotante"
  href={hrefWhatsApp(mensajeWhatsApp)}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribir por WhatsApp"
  class="pointer-events-none fixed right-4 z-80 inline-flex h-13 w-13 translate-y-2 items-center justify-center rounded-full bg-brand-blue text-n-0 opacity-0 shadow-lg shadow-black/40 transition-[opacity,transform,background-color] duration-300 hover:bg-brand-blue-hover"
  style="bottom: max(1rem, env(safe-area-inset-bottom))"
>
  <MessageCircle className="h-6 w-6" aria-hidden="true" />
</a>

<script>
  const boton = document.getElementById("whatsapp-flotante");
  if (boton) {
    let visible: boolean | null = null;
    const alScroll = () => {
      const ahora = window.scrollY > 500;
      if (ahora === visible) return;
      visible = ahora;
      boton.classList.toggle("pointer-events-none", !ahora);
      boton.classList.toggle("opacity-0", !ahora);
      boton.classList.toggle("translate-y-2", !ahora);
    };
    alScroll();
    window.addEventListener("scroll", alScroll, { passive: true });
  }
</script>
