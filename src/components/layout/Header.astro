---
import { Menu, Phone, X } from "lucide-react";
import BrandLogo from "@/components/ui/BrandLogo.astro";
import EnlaceBoton from "@/components/ui/EnlaceBoton.astro";
import {
  hrefTelefono,
  hrefWhatsApp,
  mensajeWhatsApp,
  navLegal,
  navPrincipal,
  site,
} from "@/content/site";

/**
 * Cabecera y menú móvil.
 *
 * El enlace activo se calcula aquí, en la compilación. Al navegador solo viaja
 * el script del final: compacta la cabecera al bajar y abre y cierra el menú.
 */
const ruta = Astro.url.pathname.replace(/\/+$/, "") || "/";
/* Un enlace a un ancla de la portada no marca sección: la portada no es una
   sección de la navegación. */
const activo = (href: string) => {
  if (href.includes("#")) return false;
  return ruta === href || ruta.startsWith(`${href}/`);
};
---

<header
  id="cabecera"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,backdrop-filter,border-color] duration-300"
  style="padding-top: env(safe-area-inset-top)"
>
  <div
    id="cabecera-barra"
    class="container-brand flex h-18 items-center justify-between gap-6 transition-[height] duration-300 md:h-20"
  >
    <a
      href="/"
      class="flex shrink-0 items-center py-2 transition-opacity hover:opacity-70"
      aria-label={`${site.nombre} · Inicio`}
    >
      <BrandLogo class="h-8 sm:h-9" alt="" />
      <span class="sr-only">{site.nombre}</span>
    </a>

    <nav aria-label="Navegación principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          navPrincipal.map((enlace) => (
            <li>
              <a
                href={enlace.href}
                aria-current={activo(enlace.href) ? "page" : undefined}
                class:list={[
                  "enlace-nav flex min-h-11 items-center px-4 text-sm font-semibold transition-colors",
                  /* `--n-300` y no `--n-400`: la cabecera es transparente y se
                     apoya sobre lo que haya debajo, que puede ser la franja
                     azul de `/contacto`. Sobre #23366F el tono tenue se queda
                     en 4,2:1 y este da 6,8:1. */
                  activo(enlace.href) ? "text-fg" : "text-fg-muted hover:text-fg",
                ]}
              >
                {enlace.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      {/* Sin el número a la vista: es una cabecera, no la ficha de contacto.
          El icono llama igual, y quien quiera leer el número lo tiene en el
          menú, en el pie o en la propia página de contacto. */}
      <a
        href={hrefTelefono()}
        aria-label={`Llamar al ${site.nap.telefono}`}
        title={site.nap.telefono}
        class="hairline hidden h-11 w-11 items-center justify-center rounded-full text-fg-muted transition-colors hover:border-fg/35 hover:text-fg md:inline-flex"
      >
        <Phone className="h-4 w-4" aria-hidden="true" />
      </a>

      {/* El envoltorio controla la visibilidad: `hidden` sobre el propio botón
          no gana a su `inline-flex` de base. */}
      <span class="hidden sm:block">
        <EnlaceBoton href="/contacto" data-evento="presupuesto_cta">Presupuesto</EnlaceBoton>
      </span>

      <button
        id="abrir-menu"
        type="button"
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú"
        class="hairline inline-flex h-11 w-11 items-center justify-center rounded-full text-fg transition-colors hover:border-fg/35 lg:hidden"
      >
        <Menu className="h-5 w-5" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<div
  id="menu-movil"
  class="menu-movil z-100 flex flex-col bg-bg lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
  inert
  style="padding-top: env(safe-area-inset-top); padding-bottom: env(safe-area-inset-bottom)"
>
  <div class="container-brand flex h-18 shrink-0 items-center justify-between">
    <BrandLogo class="h-7" alt="" />
    <button
      id="cerrar-menu"
      type="button"
      aria-label="Cerrar menú"
      class="hairline inline-flex h-11 w-11 items-center justify-center rounded-full text-fg"
    >
      <X className="h-5 w-5" aria-hidden="true" />
    </button>
  </div>

  <nav
    aria-label="Navegación principal"
    class="container-brand flex-1 overflow-y-auto py-4"
  >
    {/* Sin un «Contacto» aparte: repetiría lo que ya hacen los dos botones
        de debajo, y aquí cada línea de más se paga en tamaño de letra. */}
    <ul class="flex flex-col">
      {
        navPrincipal.map((enlace) => (
          <li class="hairline-b">
            <a href={enlace.href} class="flex items-center py-5 font-display text-3xl">
              {enlace.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-8 flex flex-col gap-3">
      <EnlaceBoton href="/contacto" data-evento="presupuesto_cta" tamano="lg" class="w-full">
        Solicitar presupuesto
      </EnlaceBoton>
      <EnlaceBoton
        href={hrefWhatsApp(mensajeWhatsApp)}
        variante="secundario"
        tamano="lg"
        class="w-full"
      >
        Escribir por WhatsApp
      </EnlaceBoton>
      <a
        href={hrefTelefono()}
        class="flex min-h-11 items-center justify-center gap-2 text-sm text-fg-muted"
      >
        <Phone className="h-4 w-4" aria-hidden="true" />
        {site.nap.telefono}
      </a>
    </div>

    <ul class="mt-10 flex flex-wrap gap-x-5 pb-6 text-xs text-fg-dim">
      {
        navLegal.map((enlace) => (
          <li>
            <a href={enlace.href} class="flex min-h-11 items-center hover:text-fg">
              {enlace.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script>
  const cabecera = document.getElementById("cabecera");
  const barra = document.getElementById("cabecera-barra");
  const menu = document.getElementById("menu-movil");
  const abrir = document.getElementById("abrir-menu");
  const cerrar = document.getElementById("cerrar-menu");

  /* --- Compactar la cabecera al bajar --- */
  if (cabecera && barra) {
    const compactas = ["border-line", "bg-bg/85", "backdrop-blur-xl"];
    let compacto: boolean | null = null;

    const alScroll = () => {
      const ahora = window.scrollY > 16;
      if (ahora === compacto) return;
      compacto = ahora;
      cabecera.classList.toggle("border-transparent", !ahora);
      compactas.forEach((c) => cabecera.classList.toggle(c, ahora));
      barra.classList.toggle("h-16", ahora);
      barra.classList.toggle("h-18", !ahora);
      barra.classList.toggle("md:h-20", !ahora);
    };

    alScroll();
    window.addEventListener("scroll", alScroll, { passive: true });
  }

  /* --- Menú móvil: apertura, foco atrapado y cierre con Escape --- */
  if (menu && abrir && cerrar) {
    const focusables = () =>
      Array.from(
        menu.querySelectorAll<HTMLElement>("a[href], button:not([disabled])"),
      ).filter((el) => el.offsetParent !== null);

    const alTeclado = (e: KeyboardEvent) => {
      if (e.key === "Escape") return cerrarMenu();
      if (e.key !== "Tab") return;
      const lista = focusables();
      if (lista.length === 0) return;
      const primero = lista[0];
      const ultimo = lista[lista.length - 1];
      if (e.shiftKey && document.activeElement === primero) {
        e.preventDefault();
        ultimo.focus();
      } else if (!e.shiftKey && document.activeElement === ultimo) {
        e.preventDefault();
        primero.focus();
      }
    };

    function abrirMenu() {
      menu!.removeAttribute("inert");
      menu!.dataset.abierto = "";
      abrir!.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      document.addEventListener("keydown", alTeclado);
      focusables()[0]?.focus();
    }

    function cerrarMenu() {
      menu!.setAttribute("inert", "");
      delete menu!.dataset.abierto;
      abrir!.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      document.removeEventListener("keydown", alTeclado);
      abrir!.focus();
    }

    abrir.addEventListener("click", abrirMenu);
    cerrar.addEventListener("click", cerrarMenu);
    /* Al tocar un enlace del menú, se cierra antes de navegar. */
    menu.querySelectorAll("a[href]").forEach((a) =>
      a.addEventListener("click", () => {
        menu.setAttribute("inert", "");
        delete menu.dataset.abierto;
        document.body.style.overflow = "";
      }),
    );
  }
</script>
