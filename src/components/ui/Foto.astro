---
import { fotos, type NombreFoto, type Variante } from "@/content/fotos";
import { cn } from "@/lib/utils";

type Props = {
  /** Clave de `src/content/fotos.ts`. */
  nombre: NombreFoto;
  /** Texto alternativo real y descriptivo. */
  alt: string;
  class?: string;
  /** `sizes` correcto para no descargar de más en móvil. */
  sizes?: string;
  /** Solo para la imagen principal de la primera pantalla. */
  priority?: boolean;
  objectPosition?: string;
  /** Proporción reservada, para que no haya salto de maquetación. */
  ratio?: string;
};

const {
  nombre,
  alt,
  class: clase,
  sizes = "(max-width: 768px) 100vw, 50vw",
  priority = false,
  objectPosition,
  ratio,
} = Astro.props;

const foto = fotos[nombre];
const srcset = (lista: Variante[]) => lista.map((v) => `${v.src} ${v.ancho}w`).join(", ");

/* La miniatura borrosa va de fondo del propio `img`: ocupa el hueco mientras
   carga la foto real y desaparece sola al pintarse encima. */
const estilo = [
  objectPosition ? `object-position:${objectPosition}` : null,
  `background-image:url("${foto.blur}")`,
  "background-size:cover",
  `background-position:${objectPosition ?? "center"}`,
]
  .filter(Boolean)
  .join(";");
---

{/* Las fotografías van sin ningún filtro: tal y como se tomaron.

    `decoding` es siempre asíncrono. Con `sync`, el navegador descodifica la
    imagen en el hilo principal y en una foto grande eso bloquea medio segundo
    la interacción; la prioridad de descarga se pide con `fetchpriority`, que
    no tiene ese coste. */}
<div
  class={cn("relative overflow-hidden bg-surface", clase)}
  style={ratio ? `aspect-ratio:${ratio}` : undefined}
>
  <picture>
    <source type="image/avif" srcset={srcset(foto.variantes.avif)} sizes={sizes} />
    <source type="image/webp" srcset={srcset(foto.variantes.webp)} sizes={sizes} />
    <img
      src={foto.src}
      alt={alt}
      width={foto.ancho}
      height={foto.alto}
      sizes={sizes}
      loading={priority ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={priority ? "high" : undefined}
      class="h-full w-full object-cover"
      style={estilo}
    />
  </picture>
</div>
