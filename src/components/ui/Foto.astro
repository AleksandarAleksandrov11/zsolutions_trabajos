---
import { fotos, type NombreFoto, type Variante } from "@/content/fotos";
import { cn } from "@/lib/utils";

type Props = {
  /** Clave de `src/content/fotos.ts`. */
  nombre: NombreFoto;
  /** Texto alternativo real y descriptivo. Obligatorio. */
  alt: string;
  class?: string;
  /** `sizes` correcto para no descargar de más en móvil. */
  sizes?: string;
  /** Solo en el hero de la home. */
  priority?: boolean;
  /**
   * Tratamiento fotográfico del manual (apartado 05):
   * · "bn"    blanco y negro puro
   * · "duo"   desaturada con capa azul corporativo sutil
   * · "color" sin tratamiento, para galería
   */
  tratamiento?: "bn" | "duo" | "color";
  objectPosition?: string;
  ratio?: string;
};

const {
  nombre,
  alt,
  class: clase,
  sizes = "(max-width: 768px) 100vw, 50vw",
  priority = false,
  tratamiento = "duo",
  objectPosition,
  ratio,
} = Astro.props;

const foto = fotos[nombre];
const srcset = (lista: Variante[]) => lista.map((v) => `${v.src} ${v.ancho}w`).join(", ");

/* La miniatura borrosa va de fondo del propio `img`: ocupa el hueco mientras
   carga la foto real y desaparece sola al pintarse encima. Ni salto de
   maquetación ni rectángulo vacío, y sin una línea de JavaScript. */
const estiloImagen = [
  objectPosition ? `object-position:${objectPosition}` : null,
  `background-image:url("${foto.blur}")`,
  "background-size:cover",
  `background-position:${objectPosition ?? "center"}`,
].filter(Boolean).join(";");
---

<div
  class={cn("relative overflow-hidden bg-surface", clase)}
  style={ratio ? `aspect-ratio:${ratio}` : undefined}
>
  <picture>
    <source type="image/avif" srcset={srcset(foto.variantes.avif)} sizes={sizes} />
    <source type="image/webp" srcset={srcset(foto.variantes.webp)} sizes={sizes} />
    <img
      src={foto.src}
      alt={alt}
      width={foto.ancho}
      height={foto.alto}
      sizes={sizes}
      loading={priority ? "eager" : "lazy"}
      decoding={priority ? "sync" : "async"}
      fetchpriority={priority ? "high" : undefined}
      class={cn(
        "h-full w-full object-cover",
        tratamiento === "bn" && "grayscale",
        tratamiento === "duo" && "grayscale-[0.72] contrast-[1.06]",
      )}
      style={estiloImagen}
    />
  </picture>

  {/* Capa de color corporativo. El manual la permite entre el 60 % y el 80 %
      cuando encima va texto; aquí, sin texto, se usa muy contenida para
      unificar la fotografía con la paleta. */}
  {
    tratamiento === "duo" ? (
      <div
        class="pointer-events-none absolute inset-0 mix-blend-color"
        style="background-color:rgba(47,74,160,.42)"
        aria-hidden="true"
      />
    ) : null
  }
</div>
