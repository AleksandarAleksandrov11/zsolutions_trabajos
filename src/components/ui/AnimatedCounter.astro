---
type Props = {
  valor: number;
  sufijo?: string;
  prefijo?: string;
  class?: string;
};

const { valor, sufijo = "", prefijo = "", class: clase } = Astro.props;

/**
 * Contador que sube desde cero al entrar en pantalla.
 *
 * El HTML ya trae el valor final escrito: si el JavaScript no llega, la cifra
 * correcta está ahí igualmente. El script de `Base.astro` solo se encarga de
 * la animación, y con `prefers-reduced-motion` ni siquiera eso.
 */
---

<span class={clase}>{prefijo}<span data-contador={valor}>{valor}</span>{sufijo}</span>
