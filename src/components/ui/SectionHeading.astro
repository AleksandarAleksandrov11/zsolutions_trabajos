---
import { cn } from "@/lib/utils";

type Props = {
  /** Numeración de sección del manual: "01", "02"… */
  numero?: string;
  eyebrow?: string;
  titulo: string;
  /** `id` del titular, para enlazarlo desde `aria-labelledby`. */
  tituloId?: string;
  descripcion?: string;
  class?: string;
  alineacion?: "izquierda" | "centro";
  como?: "h2" | "h3";
};

const {
  numero,
  eyebrow,
  titulo,
  tituloId,
  descripcion,
  class: clase,
  alineacion = "izquierda",
  como: Como = "h2",
} = Astro.props;
---

<div class={cn("max-w-2xl", alineacion === "centro" && "mx-auto text-center", clase)}>
  {
    numero || eyebrow ? (
      <p
        class={cn(
          "mb-4 flex items-center gap-2.5",
          alineacion === "centro" && "justify-center",
        )}
      >
        {numero ? <span class="num-seccion">{numero}</span> : null}
        {/* El filete de acento: junto con la numeración, es lo que garantiza
            que ninguna pantalla se quede sin naranja. */}
        <span class="regla-acento h-px w-6" aria-hidden="true" />
        {eyebrow ? <span class="text-eyebrow text-fg-dim">{eyebrow}</span> : null}
      </p>
    ) : null
  }
  <Como class="text-4xl" id={tituloId}>{titulo}</Como>
  {descripcion ? <p class="mt-4 text-lg text-fg-muted">{descripcion}</p> : null}
</div>
