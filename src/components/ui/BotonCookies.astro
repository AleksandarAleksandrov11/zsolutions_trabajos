---
import { cn } from "@/lib/utils";

type Props = { class?: string };
const { class: clase } = Astro.props;

/**
 * Enlace permanente para volver a abrir el panel de cookies.
 *
 * No lleva manejador propio: se marca con `data-abrir-cookies` y el banner
 * escucha el clic de forma delegada, así puede aparecer en varios sitios sin
 * que ninguna página cargue nada extra.
 */
---

<button
  type="button"
  data-abrir-cookies
  class={cn(
    "flex min-h-11 items-center text-left text-fg-muted transition-colors hover:text-fg",
    clase,
  )}
>
  Configuración de cookies
</button>
