---
import { cn } from "@/lib/utils";

/**
 * Logotipo oficial de ZSolutions.
 *
 * Los SVG de `public/logo` están extraídos del Manual Básico de Identidad
 * Visual Corporativa, sin redibujar: son las curvas originales. Sobre el fondo
 * oscuro de la web se usa la versión a una tinta blanca, que es la que el
 * propio manual prescribe cuando el fondo no permite leer la versión a color
 * (apartado «Variantes: logotipo a una tinta»).
 *
 * El manual prohíbe deformarlo, recolorearlo o enmarcarlo, así que aquí solo
 * se decide su altura: la proporción la mantiene el `viewBox` del archivo.
 */
type Props = {
  variante?: "horizontal" | "isotipo";
  /** Una tinta blanca (por defecto) o el logotipo a color. */
  tinta?: "blanco" | "color";
  class?: string;
  /** Texto alternativo. Vacío cuando el nombre ya está al lado. */
  alt?: string;
};

const {
  variante = "horizontal",
  tinta = "blanco",
  class: clase,
  alt = "ZSolutions",
} = Astro.props;

const archivo =
  variante === "isotipo"
    ? `/logo/zsolutions-isotipo${tinta === "blanco" ? "-blanco" : ""}.svg`
    : `/logo/zsolutions-horizontal${tinta === "blanco" ? "-blanco" : ""}.svg`;

/* Relación de aspecto real de cada archivo, para reservar el hueco y que no
   haya salto de maquetación mientras carga. */
const medidas =
  variante === "isotipo" ? { w: 246, h: 160 } : { w: 503, h: 104 };
---

<img
  src={archivo}
  alt={alt}
  width={medidas.w}
  height={medidas.h}
  loading="eager"
  decoding="async"
  class={cn("block w-auto", clase)}
/>
