---
import { ChevronRight } from "lucide-react";

export type Miga = { label: string; href: string };

type Props = {
  /** Sin incluir "Inicio": se añade automáticamente. */
  migas: Miga[];
};

const { migas } = Astro.props;
const completo: Miga[] = [{ label: "Inicio", href: "/" }, ...migas];
---

<nav aria-label="Ruta de navegación" class="text-xs">
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-fg-muted/60">
    {
      completo.map((miga, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 ? (
            <ChevronRight className="h-3 w-3 shrink-0 opacity-50" aria-hidden="true" />
          ) : null}
          {i === completo.length - 1 ? (
            <span aria-current="page" class="inline-flex min-h-11 items-center text-fg-muted">
              {miga.label}
            </span>
          ) : (
            <a
              href={miga.href}
              class="inline-flex min-h-11 items-center transition-colors hover:text-fg focus-visible:text-fg"
            >
              {miga.label}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
