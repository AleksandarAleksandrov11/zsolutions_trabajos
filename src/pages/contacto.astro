---
import { Clock, Mail, MapPin, MessageCircle, Phone, ShieldCheck } from "lucide-react";
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import Reveal from "@/components/ui/Reveal.astro";
import RevealGroup from "@/components/ui/RevealGroup.astro";
import RevealItem from "@/components/ui/RevealItem.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import ProcesoSteps from "@/components/sections/ProcesoSteps.astro";
import FAQ from "@/components/sections/FAQ.astro";
import { QuoteWizard } from "@/components/forms/QuoteWizard";
import { schemaFaq, schemaMigas } from "@/lib/schema";
import { crearMetadata } from "@/lib/seo";
import {
  barraConfianza,
  hrefEmail,
  hrefTelefono,
  hrefWhatsApp,
  mensajeWhatsApp,
  site,
} from "@/content/site";
import { procesoGeneral } from "@/content/proceso";
import { faqContacto } from "@/content/faq";
import { fondoCss } from "@/lib/fondos";

const migas = [{ label: "Contacto", href: "/contacto" }];

const meta = crearMetadata({
  title: "Contacto y presupuesto | ZSolutions Barcelona",
  description:
    "Pide presupuesto a ZSolutions: formulario en cinco pasos, teléfono, WhatsApp o correo. Respuesta en menos de 24 horas, sin coste y sin compromiso.",
  path: "/contacto",
  og: "/og/contacto.jpg",
});

/* Las tres vías, con lo que aporta cada una. Quien tiene prisa llama; quien
   quiere dejarlo por escrito rellena; quien está en el trabajo escribe. */
const vias = [
  {
    icono: Phone,
    titulo: "Llamar",
    detalle: site.nap.telefono,
    pie: "Lo más rápido si es urgente",
    href: hrefTelefono(),
    externo: false,
  },
  {
    icono: MessageCircle,
    titulo: "WhatsApp",
    detalle: "Mándame fotos de lo que pasa",
    pie: "Una foto ahorra media visita",
    href: hrefWhatsApp(mensajeWhatsApp),
    externo: true,
  },
  {
    icono: Mail,
    titulo: "Correo",
    detalle: site.nap.email,
    pie: "Para comunidades y administradores",
    href: hrefEmail(),
    externo: false,
  },
];

const nombreFondo = "fondo-fachadas" as const;
---

<Base meta={meta} schema={[schemaFaq(faqContacto), schemaMigas(migas)]}>
  <header
    class="seccion-foto seccion-foto-azul pt-32 pb-16 sm:pt-40 sm:pb-20"
    style={`--foto: ${fondoCss(nombreFondo)}; --foto-posicion: center bottom`}
  >
    <div class="container-brand">
      <Breadcrumbs migas={migas} />

      <p class="text-eyebrow mt-7 flex items-center gap-3 text-brand-orange">
        <span class="regla-acento w-8" aria-hidden="true"></span>
        Contacto
      </p>
      <h1 class="mt-5 max-w-3xl text-5xl">Cuéntame qué necesitas</h1>
      <p class="mt-6 max-w-2xl text-xl text-fg-muted">
        Respondo en {site.respuesta} con una primera valoración. Sin coste y sin
        compromiso. Si el trabajo no me corresponde, también te lo diré.
      </p>

      <RevealGroup as="ul" class="rejilla-igual mt-10 sm:grid-cols-3" stagger={0.05}>
        {
          vias.map((via) => (
            <RevealItem as="li">
              <a
                href={via.href}
                target={via.externo ? "_blank" : undefined}
                rel={via.externo ? "noopener noreferrer" : undefined}
                class="tarjeta group flex h-full flex-col gap-3 p-5"
              >
                <span class="chip-icono h-11 w-11">
                  <via.icono className="h-5 w-5" aria-hidden="true" />
                </span>
                <span>
                  <span class="block text-lg font-bold">{via.titulo}</span>
                  <span class="mt-1 block text-sm text-fg-muted">{via.detalle}</span>
                </span>
                <span class="text-eyebrow mt-auto block text-fg-dim">{via.pie}</span>
              </a>
            </RevealItem>
          ))
        }
      </RevealGroup>
    </div>
  </header>

  <section class="py-section" aria-labelledby="titulo-formulario">
    <div class="container-brand">
      <SectionHeading
        numero="01"
        eyebrow="Presupuesto"
        tituloId="titulo-formulario"
        titulo="Cinco pasos cortos"
        descripcion="Cuanto mejor entienda el trabajo, más útil será la primera valoración y menos vueltas daremos después."
      />

      <div class="mt-12 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,20rem)] lg:gap-10">
        {/* Única parte de la web que necesita ejecutarse en el navegador. */}
        <QuoteWizard client:load />

        <aside class="flex flex-col gap-4 lg:sticky lg:top-28 lg:self-start">
          <div class="tarjeta p-6">
            <h2 class="text-eyebrow mb-4 text-fg-dim">Datos y horario</h2>
            <ul class="flex flex-col gap-4 text-sm text-fg-muted">
              <li class="flex items-start gap-3">
                <MapPin className="mt-0.5 h-4 w-4 shrink-0 text-n-400" aria-hidden="true" />
                <span>
                  {site.nap.calle}<br />
                  {site.nap.codigoPostal} {site.nap.ciudad}
                </span>
              </li>
              <li class="flex items-start gap-3">
                <Clock className="mt-0.5 h-4 w-4 shrink-0 text-n-400" aria-hidden="true" />
                {site.nap.horario}
              </li>
              <li class="flex items-start gap-3">
                <ShieldCheck className="mt-0.5 h-4 w-4 shrink-0 text-n-400" aria-hidden="true" />
                <span>
                  {site.nap.razonSocial}<br />
                  NIF {site.nap.nif}
                </span>
              </li>
            </ul>
          </div>

          <div class="tarjeta p-6">
            <h2 class="text-eyebrow mb-4 text-fg-dim">Con quién hablas</h2>
            <ul class="flex flex-col gap-2">
              {
                barraConfianza.map((item) => (
                  <li class="flex items-center gap-2.5 text-sm text-fg-muted">
                    <span class="h-1 w-1 shrink-0 rounded-full bg-brand-orange" aria-hidden="true" />
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>

          <Reveal class="tarjeta overflow-hidden">
            <a href="/testimonios" class="block p-6">
              <span class="text-eyebrow block text-brand-orange">Opiniones</span>
              <span class="mt-3 block text-lg font-bold">
                Lo que dicen quienes ya han trabajado conmigo
              </span>
              <span class="text-eyebrow mt-4 block text-fg-dim">Ver todas</span>
            </a>
          </Reveal>
        </aside>
      </div>
    </div>
  </section>

  <ProcesoSteps pasos={procesoGeneral} numero="02" titulo="Qué pasa después de que escribas" />
  <FAQ preguntas={faqContacto} numero="03" titulo="Dudas antes de escribir" />
</Base>
