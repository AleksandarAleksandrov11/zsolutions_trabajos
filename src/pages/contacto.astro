---
import { Clock, Mail, MapPin, MessageCircle, Phone } from "lucide-react";
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import { QuoteWizard } from "@/components/forms/QuoteWizard";
import { schemaMigas } from "@/lib/schema";
import { crearMetadata } from "@/lib/seo";
import {
  barraConfianza,
  hrefEmail,
  hrefTelefono,
  hrefWhatsApp,
  mensajeWhatsApp,
  site,
} from "@/content/site";

const migas = [{ label: "Contacto", href: "/contacto" }];

const meta = crearMetadata({
  title: "Solicitar presupuesto | ZSolutions · Barcelona",
  description:
    "Cuéntame qué necesitas en cinco pasos y respondo en menos de 24 horas con una primera valoración. Sin coste y sin compromiso.",
  path: "/contacto",
  og: "/og/contacto.jpg",
});

const atajos = [
  {
    href: hrefWhatsApp(mensajeWhatsApp),
    icono: MessageCircle,
    titulo: "WhatsApp",
    detalle: site.nap.telefono,
    externo: true,
  },
  {
    href: hrefTelefono(),
    icono: Phone,
    titulo: "Llamada directa",
    detalle: site.nap.telefono,
    externo: false,
  },
  {
    href: hrefEmail(),
    icono: Mail,
    titulo: "Correo electrónico",
    detalle: site.nap.email,
    externo: false,
  },
];
---

<Base meta={meta} schema={schemaMigas(migas)}>
  {/* Franja de marca de entrada: es la única página sin bloque de cierre azul,
      porque el cierre aquí es el propio formulario. */}
  <header class="seccion-azul pt-32 pb-14 sm:pt-40">
    <div class="container-brand">
      <Breadcrumbs migas={migas} />
      <h1 class="mt-7 max-w-3xl text-5xl">Cuéntame qué necesitas</h1>
      <p class="mt-5 max-w-2xl text-lg text-fg-muted">
        Cinco pasos cortos. Cuanto mejor entienda el trabajo, más útil será la primera
        valoración y menos vueltas daremos después. Respondo en {site.respuesta}.
      </p>
    </div>
  </header>

  <section class="pb-section" aria-label="Formulario de presupuesto">
    <div class="container-brand">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,19rem)] lg:gap-10">
        {/* Única parte de la web que necesita ejecutarse en el navegador. */}
        <QuoteWizard client:load />

        <aside class="flex flex-col gap-4 lg:sticky lg:top-28 lg:self-start">
          <div class="tarjeta p-6">
            <h2 class="text-eyebrow mb-4 text-fg-dim">¿Prefieres el camino corto?</h2>
            <ul class="flex flex-col gap-2">
              {
                atajos.map((a) => (
                  <li>
                    <a
                      href={a.href}
                      target={a.externo ? "_blank" : undefined}
                      rel={a.externo ? "noopener noreferrer" : undefined}
                      class="hairline flex min-h-14 items-center gap-3 rounded-xl px-4 text-sm transition-colors hover:border-fg/35"
                    >
                      <a.icono
                        className="h-4 w-4 shrink-0 text-n-400"
                        aria-hidden="true"
                      />
                      <span>
                        <span class="block font-bold">{a.titulo}</span>
                        <span class="block text-xs text-fg-dim">{a.detalle}</span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="tarjeta p-6">
            <h2 class="text-eyebrow mb-4 text-fg-dim">Datos y horario</h2>
            <ul class="flex flex-col gap-3 text-sm text-fg-muted">
              <li class="flex items-start gap-3">
                <MapPin className="mt-0.5 h-4 w-4 shrink-0 text-n-400" aria-hidden="true" />
                <span>
                  {site.nap.calle}<br />
                  {site.nap.codigoPostal} {site.nap.ciudad}
                </span>
              </li>
              <li class="flex items-start gap-3">
                <Clock className="mt-0.5 h-4 w-4 shrink-0 text-n-400" aria-hidden="true" />
                {site.nap.horario}
              </li>
            </ul>
          </div>

          <div class="tarjeta p-6">
            <h2 class="text-eyebrow mb-4 text-fg-dim">Con quién hablas</h2>
            <ul class="flex flex-col gap-2">
              {
                barraConfianza.map((item) => (
                  <li class="flex items-center gap-2.5 text-sm text-fg-muted">
                    <span class="h-1 w-1 shrink-0 rounded-full bg-n-500" aria-hidden="true" />
                    {item}
                  </li>
                ))
              }
            </ul>
            <p class="mt-5 text-xs text-fg-dim">
              Quien recibe esta solicitud es {site.fundador}, no una centralita.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>
