---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Reveal from "@/components/ui/Reveal.astro";
import RevealGroup from "@/components/ui/RevealGroup.astro";
import RevealItem from "@/components/ui/RevealItem.astro";
import MapaZonas from "@/components/sections/MapaZonas.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { schemaMigas } from "@/lib/schema";
import { crearMetadata } from "@/lib/seo";
import { agrupaciones, agrupacionDe, hrefZona, zonas, zonasPorComarca } from "@/content/zonas";
import EnlaceBoton from "@/components/ui/EnlaceBoton.astro";
import { fotos } from "@/content/fotos";
import { hrefWhatsApp, mensajeWhatsApp, site } from "@/content/site";
import BandaContacto from "@/components/sections/BandaContacto.astro";

const migas = [{ label: "Zonas", href: "/zonas" }];
const porComarca = zonasPorComarca();

const meta = crearMetadata({
  title: "Zonas de actuación en Barcelona y Cataluña | ZSolutions",
  description:
    "Instalaciones en Barcelona, área metropolitana, Vallès, Baix Llobregat, Maresme, Garraf, Bages y Gironès. Presupuesto en menos de 24 horas.",
  path: "/zonas",
  og: "/og/zonas.jpg",
});
---

<Base meta={meta} schema={schemaMigas(migas)}>
  <header
    class="seccion-foto pt-32 pb-16 sm:pt-40 sm:pb-20"
    style={`--foto: url("${fotos["fondo-fachadas"].src}"); --foto-posicion: center bottom`}
  >
    <div class="container-brand">
      <Breadcrumbs migas={migas} />
      <p class="text-eyebrow mt-7 flex items-center gap-3 text-brand-orange">
        <span class="regla-acento w-8" aria-hidden="true"></span>
        Zonas de actuación
      </p>
      <h1 class="mt-5 max-w-3xl text-5xl">Barcelona, área metropolitana y Cataluña</h1>
      <p class="mt-5 max-w-2xl text-lg text-fg-muted">
        Base en {site.nap.ciudad} y salida habitual a {zonas.length} municipios del área
        metropolitana y del resto de Cataluña. Si el tuyo no aparece, pregúntame
        igualmente: para un aviso corto muy lejos te diré con franqueza si te conviene
        alguien más cercano.
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <EnlaceBoton href="/contacto" tamano="lg" data-evento="presupuesto_cta">
          Solicitar presupuesto
        </EnlaceBoton>
        <EnlaceBoton href={hrefWhatsApp(mensajeWhatsApp)} variante="secundario" tamano="lg">
          WhatsApp
        </EnlaceBoton>
      </div>
    </div>
  </header>

  <section class="pb-section" aria-label="Mapa y listado de zonas">
    <div class="container-brand">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1fr)] lg:items-start lg:gap-16">
        <Reveal class="tarjeta p-5 sm:p-7 lg:sticky lg:top-28">
          <MapaZonas />
          <p class="mt-4 text-xs text-fg-dim">
            Contorno real de Cataluña. Cada punto está en las coordenadas de su municipio
            y lleva a su zona.
          </p>
        </Reveal>

        <RevealGroup class="flex flex-col gap-10">
          {
            porComarca.map((grupo) => (
              <RevealItem>
                <h2 class="text-eyebrow hairline-b mb-4 flex items-baseline justify-between gap-4 pb-2 text-fg-dim">
                  {grupo.comarca}
                  <span class="font-display text-brand-orange">
                    {String(grupo.zonas.length).padStart(2, "0")}
                  </span>
                </h2>
                <ul class="flex flex-col gap-3">
                  {grupo.zonas.map((zona) => (
                    <li id={`zona-${zona.slug}`} class="scroll-mt-28">
                      {/* Fila enlazada solo si su agrupación tiene página; si
                          no, un enlace al propio ancla no llevaría a ninguna
                          parte. El mapa apunta aquí en ese caso. */}
                      {agrupacionDe(zona.slug)?.publicada ? (
                        <a href={hrefZona(zona)} class="tarjeta block p-5" data-fila-zona={zona.slug}>
                          <h3 class="text-lg font-bold">{zona.nombreLargo}</h3>
                          <p class="mt-1.5 text-sm text-fg-muted">{zona.claim}</p>
                        </a>
                      ) : (
                        <div class="tarjeta p-5" data-fila-zona={zona.slug}>
                          <h3 class="text-lg font-bold">{zona.nombreLargo}</h3>
                          <p class="mt-1.5 text-sm text-fg-muted">{zona.claim}</p>
                        </div>
                      )}
                    </li>
                  ))}
                </ul>
              </RevealItem>
            ))
          }
        </RevealGroup>
      </div>
    </div>
  </section>

  {/* Las agrupaciones con página propia, arriba del listado largo. */}
  <section class="seccion-alterna py-section" aria-labelledby="titulo-agrupaciones">
    <div class="container-brand">
      <SectionHeading
        numero="01"
        eyebrow="Por zona"
        tituloId="titulo-agrupaciones"
        titulo="Las zonas con más trabajo, en detalle"
        descripcion="Cada una con lo que la hace distinta: cómo está construida, qué instalación tiene de origen y qué es lo que más sale."
      />

      <RevealGroup as="ul" class="mt-12 grid gap-4 sm:grid-cols-2" stagger={0.05}>
        {
          agrupaciones
            .filter((a) => a.publicada)
            .map((a) => (
              <RevealItem as="li">
                <a href={`/zonas/${a.slug}`} class="tarjeta flex h-full flex-col p-6">
                  <span class="block text-xl font-bold">{a.nombre}</span>
                  <span class="mt-2 block text-sm text-fg-muted">{a.entradilla}</span>
                  <span class="text-eyebrow mt-4 block text-fg-dim">
                    {a.municipios.length}
                    {a.municipios.length === 1 ? " municipio" : " municipios"}
                  </span>
                </a>
              </RevealItem>
            ))
        }
      </RevealGroup>
    </div>
  </section>

  <BandaContacto claim="¿No ves tu municipio? Pregúntame igualmente: casi siempre llego." />

  <CTASection
    titulo="¿Trabajas o vives en alguna de estas zonas?"
    descripcion={`Cuéntame qué necesitas y respondo en ${site.respuesta} con una primera valoración, sin coste y sin compromiso.`}
  />
</Base>
