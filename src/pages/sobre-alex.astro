---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import EnlaceBoton from "@/components/ui/EnlaceBoton.astro";
import Foto from "@/components/ui/Foto.astro";
import Reveal from "@/components/ui/Reveal.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Timeline from "@/components/sections/Timeline.astro";
import Certifications from "@/components/sections/Certifications.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { schemaMigas, schemaPersona } from "@/lib/schema";
import { crearMetadata } from "@/lib/seo";
import { bioAlex } from "@/content/trayectoria";
import { barraConfianza, site } from "@/content/site";
import BandaContacto from "@/components/sections/BandaContacto.astro";
import Contadores from "@/components/sections/Contadores.astro";

const migas = [{ label: "Sobre Alex", href: "/sobre-alex" }];

const meta = crearMetadata({
  title: "Alex Zsurzs · Instalador certificado en Barcelona",
  description:
    "De peón de obra en 2012 a instalador certificado con REBT, RITE, F-Gas e IRATA Nivel 3. Trayectoria, acreditaciones y forma de trabajar.",
  path: "/sobre-alex",
});
---

<Base meta={meta} schema={[schemaPersona(), schemaMigas(migas)]}>
  <header class="pt-32 pb-12 sm:pt-40 sm:pb-16">
    <div class="container-brand">
      <Breadcrumbs migas={migas} />

      <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.7fr)] lg:items-end lg:gap-16">
        <div>
          <p class="text-eyebrow text-brand-orange">Quién está detrás</p>
          <h1 class="mt-5 text-6xl">{site.fundador}</h1>
          <p class="mt-6 max-w-xl text-lg text-fg-muted">{bioAlex}</p>

          <ul class="hairline-t mt-9 flex flex-wrap gap-x-5 gap-y-2 pt-5">
            {
              barraConfianza.map((item) => (
                <li class="text-eyebrow flex items-center gap-2 text-fg-dim">
                  <span class="h-1 w-1 rounded-full bg-n-500" aria-hidden="true" />
                  {item}
                </li>
              ))
            }
          </ul>

          <div class="mt-9">
            <EnlaceBoton href="/contacto" tamano="lg">Solicitar presupuesto</EnlaceBoton>
          </div>
        </div>

        <Reveal>
          <Foto
            nombre="alex-cubierta-barcelona"
            alt="Alex Zsurzs con arnés y casco en el pretil de una cubierta de Barcelona, al atardecer"
            ratio="4 / 5"
            sizes="(max-width: 1024px) 90vw, 400px"
            objectPosition="55% 30%"
            class="rounded-2xl"
          />
        </Reveal>
      </div>
    </div>
  </header>

  <section class="py-section" aria-labelledby="titulo-metodo">
    <div class="container-brand">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.55fr)] lg:gap-16">
        <Reveal>
          <SectionHeading
            numero="01"
            eyebrow="Forma de trabajar"
            tituloId="titulo-metodo"
            titulo="Aprendí el oficio desde abajo"
          />

          <div class="prosa mt-8 max-w-2xl text-lg">
            <p>
              Empecé en 2012 como peón de obra. No es una frase de currículum: es la
              razón por la que sé lo que pasa cuando un plano se convierte en una pared
              real, cuando el hueco previsto no existe y cuando alguien decide resolverlo
              rápido en lugar de resolverlo bien.
            </p>
            <p>
              Durante años vi la misma escena repetida: instalaciones ejecutadas por
              gente sin habilitación, cuadros sin etiquetar, cargas de refrigerante
              hechas sin carnet y trabajos en altura sin plan de rescate. Nada de eso se
              nota el día de la entrega. Se nota tres años después, cuando el cliente
              paga por segunda vez el mismo trabajo.
            </p>
            <p>
              Por eso me saqué las habilitaciones y por eso las mantengo al día:
              electricista especialista en baja tensión, instalador RITE, gases
              fluorados, asesor energético, y en trabajo en altura IRATA e ITRA Nivel 3
              con especialización en espacios confinados.
            </p>
            <p>
              Mi forma de trabajar cabe en tres reglas.{" "}
              <strong>Se mide antes de decidir</strong>, porque cambiar piezas hasta
              acertar es caro y poco serio.{" "}
              <strong>Se explica antes de ejecutar</strong>, y si algo se desvía de lo
              previsto te lo cuento antes de hacerlo, no en la factura.{" "}
              <strong>Se documenta al terminar</strong>, porque una instalación sin
              documentar es un problema para el siguiente que entre, y ese siguiente
              puedes ser tú dentro de cinco años.
            </p>
            <p>
              Y hay una cuarta que no es técnica: si un trabajo no me corresponde, lo
              digo. Prefiero perder un encargo a hacerlo regular.
            </p>
          </div>
        </Reveal>

        <Reveal delay={0.1} class="flex flex-col gap-4">
          <figure>
            <Foto
              nombre="alex-premio-sector-oficios"
              alt="Alex Zsurzs sosteniendo el galardón de los Premios Sector Oficios"
              ratio="3 / 4"
              sizes="(max-width: 1024px) 90vw, 380px"
              class="rounded-2xl"
            />
            <figcaption class="mt-3 text-sm text-fg-dim">
              Galardón de los Premios Sector Oficios, categoría de instalaciones.
            </figcaption>
          </figure>

          <Foto
            nombre="alex-espacio-confinado"
            alt="Dos técnicos trabajando suspendidos por cuerda dentro de un depósito"
            ratio="4 / 5"
            sizes="(max-width: 1024px) 90vw, 380px"
            objectPosition="55% 40%"
            class="rounded-2xl"
          />
        </Reveal>
      </div>
    </div>
  </section>

  <section class="py-section" aria-labelledby="titulo-cifras">
    <div class="container-brand">
      <SectionHeading
        numero="02"
        eyebrow="En números"
        tituloId="titulo-cifras"
        titulo="La trayectoria, en cuatro cifras"
      />
      <Contadores class="mt-12" />
    </div>
  </section>

  <BandaContacto />

  <Timeline numero="03" />

  <BandaContacto claim="Si prefieres hablarlo antes de rellenar nada, llámame o escríbeme." />

  <Certifications
    numero="04"
    detallado
    titulo="Certificaciones y formación profesional"
    descripcion="Más de diez años formándome en el sector. Cada acreditación con lo que realmente habilita a hacer."
  />

  <CTASection
    titulo="¿Hablamos de tu instalación?"
    descripcion={`Cuéntame qué necesitas y respondo en ${site.respuesta} con una primera valoración. Sin coste y sin compromiso.`}
  />
</Base>
