---
import Base from "@/layouts/Base.astro";
import Cortina from "@/components/layout/Cortina.astro";
import Hero from "@/components/sections/Hero.astro";
import CintaConfianza from "@/components/sections/CintaConfianza.astro";
import Servicios from "@/components/sections/Servicios.astro";
import Sectores from "@/components/sections/Sectores.astro";
import PorQue from "@/components/sections/PorQue.astro";
import ProcesoSteps from "@/components/sections/ProcesoSteps.astro";
import Trabajos from "@/components/sections/Trabajos.astro";
import SobreAlex from "@/components/sections/SobreAlex.astro";
import Testimonios from "@/components/sections/Testimonios.astro";
import Zonas from "@/components/sections/Zonas.astro";
import Certifications from "@/components/sections/Certifications.astro";
import FAQ from "@/components/sections/FAQ.astro";
import CTASection from "@/components/sections/CTASection.astro";
import BandaContacto from "@/components/sections/BandaContacto.astro";
import { schemaFaq } from "@/lib/schema";
import { crearMetadata } from "@/lib/seo";
import { faqHome } from "@/content/faq";
import { procesoGeneral } from "@/content/proceso";

const meta = crearMetadata({
  title: "Electricista y lampista en Barcelona | ZSolutions",
  description:
    "Instalador certificado en Barcelona: electricidad, fontanería, climatización, aerotermia, lampistería y trabajos verticales. Vivienda, comunidad, local y nave. Presupuesto en menos de 24 horas.",
  path: "/",
});
---

<Base meta={meta} schema={schemaFaq(faqHome)}>
  <Cortina />

  <Hero
    portada
    titulo="Electricidad, agua y clima"
    destacado="con un solo responsable"
    entradilla="Instalador certificado en Barcelona. Vivienda, comunidad de vecinos, local y nave: quien te visita, quien presupuesta y quien firma la instalación es la misma persona."
    altFoto="Alex Zsurzs, instalador de ZSolutions, con arnés y casco en la cubierta de un edificio de Barcelona"
  />

  <div class="hairline-b bg-surface">
    <CintaConfianza tipo="frases" />
  </div>

  <Servicios numero="01" />
  <Sectores numero="02" />

  <BandaContacto claim="¿Ya sabes lo que necesitas? Cuéntamelo en un minuto por teléfono o WhatsApp." />

  <PorQue numero="03" />
  <ProcesoSteps pasos={procesoGeneral} numero="04" titulo="Cómo funciona, paso a paso" />
  <Trabajos numero="05" />

  <SobreAlex numero="06" />
  <Testimonios numero="07" />

  <Zonas numero="08" />
  <Certifications numero="09" />
  <FAQ preguntas={faqHome} numero="10" />
  <CTASection />
</Base>
