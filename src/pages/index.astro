---
import Base from "@/layouts/Base.astro";
import Hero from "@/components/sections/Hero.astro";
import ServicesGrid from "@/components/sections/ServicesGrid.astro";
import Metodo from "@/components/sections/Metodo.astro";
import Trabajos from "@/components/sections/Trabajos.astro";
import SobreAlex from "@/components/sections/SobreAlex.astro";
import Testimonios from "@/components/sections/Testimonios.astro";
import Zonas from "@/components/sections/Zonas.astro";
import FAQ from "@/components/sections/FAQ.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { schemaFaq } from "@/lib/schema";
import { crearMetadata } from "@/lib/seo";
import { faqHome } from "@/content/faq";

const meta = crearMetadata({
  title: "Electricista y lampista en Barcelona | ZSolutions",
  description:
    "Instalador certificado en Barcelona: electricidad, fontanería, climatización, aerotermia y trabajos verticales. Presupuesto en menos de 24 horas.",
  path: "/",
});
---

<Base meta={meta} schema={schemaFaq(faqHome)}>
  <Hero
    portada
    conBarraConfianza
    eyebrow="Instalador certificado en Barcelona"
    titulo="Instalaciones certificadas en Barcelona"
    descripcion="Electricidad, fontanería, climatización, aerotermia y trabajos verticales. Ejecutado y firmado por un instalador con carnet, no vendido por un intermediario que subcontrata la obra."
    foto={{
      nombre: "alex-cubierta-barcelona",
      alt: "",
      posicionMovil: "62% 18%",
      posicion: "70% 25%",
    }}
  />

  <ServicesGrid numero="01" />
  <Metodo numero="02" />
  <Trabajos numero="03" />
  <SobreAlex numero="04" />
  <Testimonios numero="05" />
  <Zonas numero="06" conEnlace />
  <FAQ preguntas={faqHome} numero="07" />
  <CTASection />
</Base>
