---
import { ArrowUpRight } from "lucide-react";
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import EnlaceBoton from "@/components/ui/EnlaceBoton.astro";
import Foto from "@/components/ui/Foto.astro";
import Reveal from "@/components/ui/Reveal.astro";
import RevealGroup from "@/components/ui/RevealGroup.astro";
import RevealItem from "@/components/ui/RevealItem.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { schemaMigas } from "@/lib/schema";
import { crearMetadata } from "@/lib/seo";
import { formacion } from "@/content/formacion";
import { site } from "@/content/site";
import { numeroSeccion } from "@/lib/utils";

const migas = [{ label: "Formación", href: "/formacion" }];

const meta = crearMetadata({
  title: "Formación para instaladores | Alex Zsurzs · ZSolutions",
  description:
    "Formación práctica para instaladores que quieren elevar su nivel: criterio técnico, documentación, trato con cliente y herramientas nacidas en obra.",
  path: "/formacion",
});
---

<Base meta={meta} schema={schemaMigas(migas)}>
  <header class="relative overflow-hidden pt-36 pb-16 md:pt-44 md:pb-20">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <div class="grid-plano absolute inset-0 opacity-70"></div>
      <div
        class="absolute inset-0"
        style="background:radial-gradient(60% 55% at 20% 0%, rgba(35,54,111,.6) 0%, transparent 62%)"
      >
      </div>
    </div>

    <div class="container-brand">
      <Breadcrumbs migas={migas} />
      <p class="text-eyebrow mt-8 mb-5 text-brand-orange">Para profesionales del sector</p>
      <h1 class="max-w-4xl text-6xl">{formacion.h1}</h1>
      <p class="mt-6 max-w-2xl text-xl text-fg-muted">{formacion.claim}</p>
      <p class="mt-6 max-w-3xl text-lg text-fg-muted">{formacion.entradilla}</p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <EnlaceBoton href={formacion.enlaceTienda} tamano="lg">
          {formacion.ctaTienda}
          <ArrowUpRight className="h-4 w-4" aria-hidden="true" />
        </EnlaceBoton>
        <EnlaceBoton href="/sobre-alex" variante="secundario" tamano="lg">
          Quién imparte la formación
        </EnlaceBoton>
      </div>
    </div>
  </header>

  <section class="pb-section" aria-labelledby="titulo-formacion">
    <div class="container-brand">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.55fr)] lg:gap-16">
        <Reveal>
          <h2 id="titulo-formacion" class="sr-only">Por qué esta formación</h2>
          <div class="prosa max-w-2xl text-lg">
            {formacion.cuerpo.map((parrafo) => <p>{parrafo}</p>)}
          </div>
        </Reveal>

        <Reveal delay={0.1}>
          <Foto
            nombre="alex-espacio-confinado"
            alt="Dos técnicos trabajando suspendidos por cuerda dentro de un depósito, con el equipo de seguridad completo"
            ratio="3 / 4"
            sizes="(max-width: 1024px) 62vw, 420px"
            objectPosition="55% 40%"
            class="rounded-[2px] border border-white/10"
          />
        </Reveal>
      </div>
    </div>
  </section>

  <section class="py-section" aria-labelledby="titulo-bloques">
    <div class="container-brand">
      <SectionHeading
        numero="01"
        eyebrow="Qué se trabaja"
        tituloId="titulo-bloques"
        titulo="Cuatro bloques, todos de obra"
      />

      <RevealGroup
        as="ul"
        class="mt-14 grid gap-px overflow-hidden rounded-[2px] border border-white/10 bg-white/10 sm:grid-cols-2"
        stagger={0.07}
      >
        {
          formacion.bloques.map((bloque, i) => (
            <RevealItem as="li" class="bg-bg p-7 sm:p-8">
              <span class="num-seccion">{numeroSeccion(i)}</span>
              <h3 class="mt-4 text-2xl">{bloque.titulo}</h3>
              <p class="mt-3 text-fg-muted">{bloque.detalle}</p>
            </RevealItem>
          ))
        }
      </RevealGroup>

      <Reveal class="mt-12">
        <div class="rounded-[2px] border border-white/10 bg-surface/50 p-7">
          <p class="text-fg-muted">{formacion.nota}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <EnlaceBoton href={formacion.enlaceTienda}>
              {formacion.ctaTienda}
              <ArrowUpRight className="h-4 w-4" aria-hidden="true" />
            </EnlaceBoton>
            <EnlaceBoton href={site.redes.instagram} variante="secundario">Instagram</EnlaceBoton>
            <EnlaceBoton href={site.redes.youtube} variante="secundario">YouTube</EnlaceBoton>
            <EnlaceBoton href={site.redes.tiktok} variante="secundario">TikTok</EnlaceBoton>
          </div>
        </div>
      </Reveal>
    </div>
  </section>

  <CTASection
    titulo="¿Necesitas una instalación, no formación?"
    descripcion="La parte de servicio de ZSolutions sigue igual de disponible. Cuéntame el trabajo y respondo en menos de 24 horas."
  />
</Base>
