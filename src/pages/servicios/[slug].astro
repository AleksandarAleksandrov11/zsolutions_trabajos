---
import { ArrowUpRight, Check } from "lucide-react";
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import EnlaceBoton from "@/components/ui/EnlaceBoton.astro";
import Reveal from "@/components/ui/Reveal.astro";
import RevealGroup from "@/components/ui/RevealGroup.astro";
import RevealItem from "@/components/ui/RevealItem.astro";
import Foto from "@/components/ui/Foto.astro";
import ProcesoSteps from "@/components/sections/ProcesoSteps.astro";
import FAQ from "@/components/sections/FAQ.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { ServiceIcon } from "@/components/ui/ServiceIcon";
import { schemaFaq, schemaMigas, schemaServicio } from "@/lib/schema";
import { crearMetadata } from "@/lib/seo";
import { servicios, type Servicio } from "@/content/servicios";
import { getCertificaciones } from "@/content/certificaciones";
import { hrefWhatsApp, site } from "@/content/site";

/* Conjunto cerrado de slugs: se generan todas sus páginas en la compilación y
   cualquier otra dirección da 404. */
export function getStaticPaths() {
  return servicios.map((servicio) => ({
    params: { slug: servicio.slug },
    props: { servicio },
  }));
}

type Props = { servicio: Servicio };
const { servicio } = Astro.props;

const migas = [
  { label: "Servicios", href: "/servicios" },
  { label: servicio.nombre, href: `/servicios/${servicio.slug}` },
];

const meta = crearMetadata({
  title: servicio.titleSeo,
  description: servicio.descriptionSeo,
  path: `/servicios/${servicio.slug}`,
});

const acreditaciones = getCertificaciones(servicio.certificaciones);
const relacionados = servicio.relacionados
  .map((s) => servicios.find((otro) => otro.slug === s))
  .filter((s): s is Servicio => Boolean(s));
const enMinusculas = servicio.nombre.toLowerCase();
---

<Base
  meta={meta}
  schema={[schemaServicio(servicio), schemaFaq(servicio.faq), schemaMigas(migas)]}
>
  <header class="pt-32 pb-12 sm:pt-40 sm:pb-16">
    <div class="container-brand">
      <Breadcrumbs migas={migas} />

      <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)] lg:items-center lg:gap-14">
        <div>
          <p class="text-eyebrow flex items-center gap-2.5 text-brand-orange">
            <ServiceIcon nombre={servicio.icono} className="h-4 w-4" />
            {servicio.nombre}
          </p>

          <h1 class="mt-5 text-5xl">{servicio.h1}</h1>
          <p class="mt-5 max-w-xl text-lg text-fg-muted">{servicio.claim}</p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <EnlaceBoton href="/contacto" tamano="lg">Solicitar presupuesto</EnlaceBoton>
            <EnlaceBoton
              href={hrefWhatsApp(`Hola Alex, me interesa el servicio de ${enMinusculas}.`)}
              variante="secundario"
              tamano="lg"
            >
              WhatsApp
            </EnlaceBoton>
          </div>

          <ul class="hairline-t mt-9 flex flex-wrap gap-x-5 gap-y-2 pt-5">
            {
              acreditaciones.slice(0, 5).map((a) => (
                <li class="text-eyebrow flex items-center gap-2 text-fg-dim">
                  <span class="h-1 w-1 rounded-full bg-n-500" aria-hidden="true" />
                  {a.siglas}
                </li>
              ))
            }
          </ul>
        </div>

        <Reveal>
          <Foto
            nombre={servicio.foto.nombre}
            alt={servicio.foto.alt}
            ratio="4 / 3"
            sizes="(max-width: 1024px) 100vw, 45vw"
            class="rounded-2xl"
          />
        </Reveal>
      </div>
    </div>
  </header>

  {/* Cuerpo editorial */}
  <section class="pb-section" aria-labelledby="titulo-detalle">
    <div class="container-brand">
      <Reveal>
        <h2 id="titulo-detalle" class="sr-only">
          En qué consiste el servicio de {enMinusculas}
        </h2>
        <p class="max-w-2xl text-xl text-fg-muted">{servicio.entradilla}</p>
        <div class="prosa mt-8 max-w-2xl text-lg">
          {servicio.cuerpo.map((parrafo) => <p>{parrafo}</p>)}
        </div>
      </Reveal>
    </div>
  </section>

  {/* Qué incluye */}
  {/* Segunda sección clara de la web: el listado de trabajos concretos es lo
      que más se lee de estas páginas, y sobre claro se lee mejor. */}
  <section class="seccion-clara py-section" aria-labelledby="titulo-incluye">
    <div class="container-brand">
      <SectionHeading
        numero="01"
        eyebrow="Qué incluye"
        tituloId="titulo-incluye"
        titulo="Trabajos concretos, no promesas"
      />

      <RevealGroup as="ul" class="mt-12 grid gap-4 md:grid-cols-2" stagger={0.04}>
        {
          servicio.incluye.map((item) => (
            <RevealItem as="li" class="tarjeta p-6">
              <h3 class="flex items-start gap-3 font-sans text-lg font-bold">
                <span class="chip-icono mt-0.5 h-6 w-6" aria-hidden="true">
                  <Check className="h-3.5 w-3.5" />
                </span>
                {item.titulo}
              </h3>
              <p class="mt-2 pl-9 text-sm text-fg-muted">{item.detalle}</p>
            </RevealItem>
          ))
        }
      </RevealGroup>
    </div>
  </section>

  {/* Para quién */}
  <section class="py-section" aria-labelledby="titulo-paraquien">
    <div class="container-brand">
      <SectionHeading
        numero="02"
        eyebrow="Para quién"
        tituloId="titulo-paraquien"
        titulo="Dónde encaja este servicio"
      />

      <RevealGroup
        as="ul"
        class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4"
        stagger={0.05}
      >
        {
          servicio.paraQuien.map((item) => (
            <RevealItem as="li" class="tarjeta p-6">
              <h3 class="text-xl">{item.titulo}</h3>
              <p class="mt-2.5 text-sm text-fg-muted">{item.detalle}</p>
            </RevealItem>
          ))
        }
      </RevealGroup>
    </div>
  </section>

  <ProcesoSteps pasos={servicio.proceso} numero="03" />

  {/* Acreditaciones aplicables */}
  <section class="seccion-alterna py-section" aria-labelledby="titulo-acreditaciones">
    <div class="container-brand">
      <SectionHeading
        numero="04"
        eyebrow="Acreditaciones aplicables"
        tituloId="titulo-acreditaciones"
        titulo="Lo que habilita para firmar este trabajo"
      />

      <RevealGroup
        as="ul"
        class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-3"
        stagger={0.04}
      >
        {
          acreditaciones.map((a) => (
            <RevealItem as="li" class="tarjeta p-5">
              <span class="font-display text-xs tracking-wider text-fg">
                {a.siglas}
              </span>
              <h3 class="mt-1.5 font-sans text-base font-bold">{a.nombre}</h3>
              <p class="mt-2 text-sm text-fg-muted">{a.detalle}</p>
            </RevealItem>
          ))
        }
      </RevealGroup>
    </div>
  </section>

  <FAQ
    preguntas={servicio.faq}
    numero="05"
    titulo={`Preguntas sobre ${enMinusculas}`}
    eyebrow="Dudas habituales"
  />

  {/* Servicios relacionados */}
  <section class="pb-section" aria-labelledby="titulo-relacionados">
    <div class="container-brand">
      <h2 class="text-eyebrow hairline-b mb-6 pb-2 text-fg-dim" id="titulo-relacionados">
        Servicios relacionados
      </h2>
      <ul class="grid gap-4 sm:grid-cols-3">
        {
          relacionados.map((otro) => (
            <li>
              <a href={`/servicios/${otro.slug}`} class="tarjeta group flex h-full flex-col p-6">
                <span class="flex items-start justify-between gap-4">
                  <span class="font-display text-xl">{otro.nombre}</span>
                  <ArrowUpRight
                    className="h-4 w-4 shrink-0 text-fg-dim transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-fg"
                    aria-hidden="true"
                  />
                </span>
                <span class="mt-2 block text-sm text-fg-muted">{otro.claim}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CTASection
    titulo={`¿Necesitas ${enMinusculas}?`}
    descripcion={`Cuéntame el trabajo y respondo en ${site.respuesta} con una primera valoración. Sin coste y sin compromiso.`}
  />
</Base>
