---
import { ArrowUpRight } from "lucide-react";
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import RevealGroup from "@/components/ui/RevealGroup.astro";
import RevealItem from "@/components/ui/RevealItem.astro";
import Foto from "@/components/ui/Foto.astro";
import { ServiceIcon } from "@/components/ui/ServiceIcon";
import Metodo from "@/components/sections/Metodo.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { schemaMigas } from "@/lib/schema";
import { crearMetadata } from "@/lib/seo";
import { servicios } from "@/content/servicios";

const migas = [{ label: "Servicios", href: "/servicios" }];

const meta = crearMetadata({
  title: "Servicios de instalación en Barcelona | ZSolutions",
  description:
    "Electricidad, fontanería, climatización, aerotermia, trabajos verticales y lampistería en Barcelona y Cataluña, con las habilitaciones en regla.",
  path: "/servicios",
});
---

<Base meta={meta} schema={schemaMigas(migas)}>
  <header class="pt-32 pb-12 sm:pt-40">
    <div class="container-brand">
      <Breadcrumbs migas={migas} />
      <h1 class="mt-7 max-w-3xl text-5xl">Seis oficios, un solo responsable</h1>
      <p class="mt-5 max-w-2xl text-lg text-fg-muted">
        Cada servicio con su habilitación oficial en regla. Cuando un trabajo toca dos
        disciplinas, y en instalaciones pasa constantemente, no hay que coordinar a dos
        empresas ni esperar a que se pongan de acuerdo sobre de quién es el problema.
      </p>
    </div>
  </header>

  <section class="pb-section" aria-label="Listado de servicios">
    <div class="container-brand">
      <RevealGroup as="ul" class="grid gap-4 md:grid-cols-2" stagger={0.06}>
        {
          servicios.map((servicio) => (
            <RevealItem as="li">
              <a
                href={`/servicios/${servicio.slug}`}
                class="tarjeta group flex h-full flex-col overflow-hidden"
              >
                <Foto
                  nombre={servicio.foto.nombre}
                  alt={servicio.foto.alt}
                  ratio="16 / 9"
                  sizes="(max-width: 768px) 100vw, 45vw"
                />
                <span class="flex flex-1 flex-col p-6 sm:p-7">
                  <span class="flex items-start justify-between gap-4">
                    <span class="flex items-center gap-3">
                      <span class="chip-icono h-10 w-10">
                        <ServiceIcon nombre={servicio.icono} className="h-5 w-5" />
                      </span>
                      <span class="font-display text-2xl">{servicio.nombre}</span>
                    </span>
                    <ArrowUpRight
                      className="mt-2 h-5 w-5 shrink-0 text-fg-dim transition-all duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-fg"
                      aria-hidden="true"
                    />
                  </span>
                  <span class="mt-4 block text-fg-muted">{servicio.claim}</span>
                </span>
              </a>
            </RevealItem>
          ))
        }
      </RevealGroup>
    </div>
  </section>

  <Metodo numero="02" tema="alterna" />
  <CTASection />
</Base>
