---
import { ArrowUpRight, Check } from "lucide-react";
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import EnlaceBoton from "@/components/ui/EnlaceBoton.astro";
import RevealGroup from "@/components/ui/RevealGroup.astro";
import RevealItem from "@/components/ui/RevealItem.astro";
import Foto from "@/components/ui/Foto.astro";
import Sectores from "@/components/sections/Sectores.astro";
import ProcesoSteps from "@/components/sections/ProcesoSteps.astro";
import CintaConfianza from "@/components/sections/CintaConfianza.astro";
import BandaContacto from "@/components/sections/BandaContacto.astro";
import FAQ from "@/components/sections/FAQ.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { ServiceIcon } from "@/components/ui/ServiceIcon";
import { schemaFaq, schemaMigas } from "@/lib/schema";
import { crearMetadata } from "@/lib/seo";
import { servicios } from "@/content/servicios";
import { procesoGeneral } from "@/content/proceso";
import { fotos } from "@/content/fotos";
import { faqHome } from "@/content/faq";

const migas = [{ label: "Servicios", href: "/servicios" }];

const meta = crearMetadata({
  title: "Servicios de instalación en Barcelona | ZSolutions",
  description:
    "Electricidad, fontanería, climatización, aerotermia, lampistería y trabajos verticales en Barcelona y Cataluña, con las habilitaciones en regla y un solo responsable.",
  path: "/servicios",
  og: "/og/servicios.jpg",
});

const fondo = fotos["textura-hormigon"];
---

<Base meta={meta} schema={[schemaFaq(faqHome), schemaMigas(migas)]}>
  <header
    class="seccion-foto pt-32 pb-16 sm:pt-40 sm:pb-20"
    style={`--foto: url("${fondo.src}")`}
  >
    <div class="container-brand">
      <Breadcrumbs migas={migas} />

      <p class="text-eyebrow mt-7 flex items-center gap-3 text-brand-orange">
        <span class="regla-acento w-8" aria-hidden="true"></span>
        Servicios
      </p>
      <h1 class="mt-5 max-w-3xl text-5xl">Seis oficios, un solo responsable</h1>
      <p class="mt-6 max-w-2xl text-xl text-fg-muted">
        Cada uno con su habilitación en regla. Cuando un trabajo toca dos
        disciplinas, no hay que coordinar a dos empresas ni esperar a que se
        pongan de acuerdo.
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <EnlaceBoton href="/contacto" tamano="lg" data-evento="presupuesto_cta">
          Pedir presupuesto
        </EnlaceBoton>
        <EnlaceBoton href="/proyectos" variante="secundario" tamano="lg">
          Ver trabajos
        </EnlaceBoton>
      </div>
    </div>
  </header>

  <div class="hairline-y bg-surface">
    <CintaConfianza tipo="frases" />
  </div>

  {/* Un bloque por servicio, alternando el lado de la foto */}
  <section class="py-section" aria-labelledby="titulo-lista-servicios">
    <div class="container-brand">
      <h2 id="titulo-lista-servicios" class="sr-only">Listado de servicios</h2>

      <div class="flex flex-col gap-16 sm:gap-24">
        {
          servicios.map((servicio, i) => (
            <RevealGroup
              as="div"
              class="grid items-center gap-8 lg:grid-cols-2 lg:gap-14"
              stagger={0.05}
            >
              <RevealItem class:list={[i % 2 === 1 && "lg:order-2"]}>
                <Foto
                  nombre={servicio.foto.nombre}
                  alt={servicio.foto.alt}
                  ratio="4 / 3"
                  sizes="(max-width: 1024px) 100vw, 44vw"
                  objectPosition={servicio.foto.posicion}
                  class="rounded-2xl"
                />
              </RevealItem>

              <RevealItem>
                <span class="chip-icono h-12 w-12">
                  <ServiceIcon nombre={servicio.icono} className="h-5 w-5" />
                </span>
                <h3 class="mt-5 text-3xl">{servicio.nombre}</h3>
                <p class="mt-4 text-lg text-fg-muted">{servicio.claim}</p>
                <p class="mt-3 text-fg-muted">{servicio.resumenHome}</p>

                <ul class="mt-6 grid gap-2 sm:grid-cols-2">
                  {servicio.incluye.slice(0, 4).map((item) => (
                    <li class="flex items-start gap-2.5 text-sm text-fg-muted">
                      <Check className="mt-0.5 h-4 w-4 shrink-0 text-brand-orange" aria-hidden="true" />
                      {item.titulo}
                    </li>
                  ))}
                </ul>

                <div class="mt-8">
                  <EnlaceBoton href={`/servicios/${servicio.slug}`} variante="secundario">
                    Ver {servicio.nombreCorto.toLowerCase()}
                    <ArrowUpRight className="h-4 w-4" aria-hidden="true" />
                  </EnlaceBoton>
                </div>
              </RevealItem>
            </RevealGroup>
          ))
        }
      </div>
    </div>
  </section>

  <BandaContacto claim="¿No sabes cuál de los seis es lo tuyo? Cuéntamelo y lo clasifico yo." />

  <Sectores numero="01" />
  <ProcesoSteps pasos={procesoGeneral} numero="02" titulo="Cómo funciona, paso a paso" />
  <FAQ preguntas={faqHome} numero="03" />
  <CTASection />
</Base>
