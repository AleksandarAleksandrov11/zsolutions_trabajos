---
import { ArrowUpRight, MapPin } from "lucide-react";
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import EnlaceBoton from "@/components/ui/EnlaceBoton.astro";
import Reveal from "@/components/ui/Reveal.astro";
import RevealGroup from "@/components/ui/RevealGroup.astro";
import RevealItem from "@/components/ui/RevealItem.astro";
import BandaContacto from "@/components/sections/BandaContacto.astro";
import FAQ from "@/components/sections/FAQ.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { ServiceIcon } from "@/components/ui/ServiceIcon";
import { schemaFaq, schemaMigas } from "@/lib/schema";
import { crearMetadata } from "@/lib/seo";
import { agrupaciones, zonas, type Agrupacion } from "@/content/zonas";
import { servicios } from "@/content/servicios";
import { fondoCss } from "@/lib/fondos";

/*
 * Página de agrupación de zona.
 *
 * No hay una página por municipio: veintiuna páginas competirían entre ellas
 * por las mismas búsquedas y ninguna tendría nada propio que contar. Se agrupa
 * por comarca o conurbación, que es como se busca de verdad, y solo se publica
 * la agrupación que tenga contenido diferenciado escrito. Las que no lo tengan
 * llevan `publicada: false` en `zonas.ts` y sus municipios siguen apuntando al
 * listado de `/zonas`.
 */
export function getStaticPaths() {
  return agrupaciones
    .filter((a) => a.publicada)
    .map((agrupacion) => ({
      params: { slug: agrupacion.slug },
      props: { agrupacion },
    }));
}

type Props = { agrupacion: Agrupacion };
const { agrupacion } = Astro.props;

const migas = [
  { label: "Zonas", href: "/zonas" },
  { label: agrupacion.nombre, href: `/zonas/${agrupacion.slug}` },
];

const meta = crearMetadata({
  title: agrupacion.metaTitulo,
  description: agrupacion.metaDescripcion,
  path: `/zonas/${agrupacion.slug}`,
  og: `/og/zonas-${agrupacion.slug}.jpg`,
});

const municipios = agrupacion.municipios
  .map((slug) => zonas.find((z) => z.slug === slug))
  .filter((z): z is (typeof zonas)[number] => Boolean(z));

const preguntas = agrupacion.faq.map((f) => ({ p: f.p, r: f.r }));

/* Numeración secuencial de las secciones numeradas de la página. Como
   algunas son condicionales (los distritos solo salen en Barcelona ciudad,
   el listado de municipios solo si hay más de uno), se lleva con un
   contador en vez de escribir la posición a mano en cada `numero`. */
let contadorSeccion = 0;
const numero = () => String(++contadorSeccion).padStart(2, "0");
---

<Base meta={meta} schema={[schemaFaq(preguntas), schemaMigas(migas)]}>
  <header
    class="seccion-foto pt-32 pb-14 sm:pt-40 sm:pb-20"
    style={`--foto: ${fondoCss("fondo-fachadas")}; --foto-posicion: center bottom`}
  >
    <div class="container-brand">
      <Breadcrumbs migas={migas} />

      <p class="text-eyebrow mt-7 flex items-center gap-2.5 text-brand-orange">
        <span class="regla-acento w-6" aria-hidden="true"></span>
        Zona de actuación
      </p>
      <h1 class="mt-5 max-w-3xl text-5xl">{agrupacion.titulo}</h1>
      <p class="mt-6 max-w-2xl text-xl text-fg-muted">{agrupacion.entradilla}</p>

      <ul class="hairline-t mt-9 flex flex-wrap gap-x-5 gap-y-2 pt-5">
        {
          municipios.map((m) => (
            <li class="text-eyebrow flex items-center gap-2 text-fg-dim">
              <MapPin className="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
              {m.nombreLargo}
            </li>
          ))
        }
      </ul>

      <div class="mt-9 flex flex-wrap gap-3">
        <EnlaceBoton href="/contacto" tamano="lg" data-evento="presupuesto_cta">
          Solicitar presupuesto
        </EnlaceBoton>
        <EnlaceBoton href="/proyectos" variante="secundario" tamano="lg">
          Ver trabajos
        </EnlaceBoton>
      </div>
    </div>
  </header>

  {/* Cuerpo editorial: por qué el trabajo es distinto aquí */}
  <section class="py-section" aria-labelledby="titulo-contexto">
    <div class="container-brand">
      <SectionHeading
        numero={numero()}
        eyebrow="La zona"
        tituloId="titulo-contexto"
        titulo={`Cómo es trabajar en ${agrupacion.nombre}`}
      />
      <Reveal class="mt-8">
        <div class="prosa max-w-2xl text-lg">
          {agrupacion.cuerpo.map((parrafo) => <p>{parrafo}</p>)}
        </div>
      </Reveal>
    </div>
  </section>

  {
    agrupacion.distritos ? (
      <section class="seccion-clara py-section" aria-labelledby="titulo-distritos">
        <div class="container-brand">
          <SectionHeading
            numero={numero()}
            eyebrow="Cobertura"
            tituloId="titulo-distritos"
            titulo="Los diez distritos"
            descripcion="Se trabaja en toda la ciudad. El criterio cambia según la finca, no según el barrio."
          />

          <RevealGroup as="ul" class="mt-10 flex flex-wrap gap-2.5" stagger={0.03}>
            {agrupacion.distritos.map((d) => (
              <RevealItem as="li" class="hairline rounded-full px-4 py-2 text-sm text-fg-muted">
                {d}
              </RevealItem>
            ))}
          </RevealGroup>
        </div>
      </section>
    ) : null
  }

  {/* Municipio a municipio: cada uno con lo que lo caracteriza, que ya está
      escrito en `zonas.ts` y aquí es donde de verdad se lee. */}
  {
    municipios.length > 1 ? (
      <section class="py-section" aria-labelledby="titulo-municipios">
        <div class="container-brand">
          <SectionHeading
            numero={numero()}
            eyebrow="Municipio a municipio"
            tituloId="titulo-municipios"
            titulo={`Qué tiene de particular cada municipio`}
          />

          <RevealGroup as="ul" class="mt-12 flex flex-col gap-3" stagger={0.04}>
            {municipios.map((m) => (
              <RevealItem as="li" class="tarjeta flex flex-col gap-2 p-5 sm:flex-row sm:items-baseline sm:gap-6">
                <span class="shrink-0 text-lg font-bold sm:w-64">{m.nombreLargo}</span>
                <span class="text-sm text-fg-muted">{m.claim}</span>
              </RevealItem>
            ))}
          </RevealGroup>
        </div>
      </section>
    ) : null
  }

  <BandaContacto claim={`¿Estás en ${agrupacion.nombre} y quieres una valoración? Cuéntamelo y te respondo hoy.`} />

  {/* Servicios, para enlazar la zona con el oficio */}
  <section class="py-section" aria-labelledby="titulo-servicios-zona">
    <div class="container-brand">
      <SectionHeading
        numero={numero()}
        eyebrow="Servicios"
        tituloId="titulo-servicios-zona"
        titulo={`Qué se puede resolver en ${agrupacion.nombre}`}
      />

      <RevealGroup as="ul" class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" stagger={0.04}>
        {
          servicios.map((s) => (
            <RevealItem as="li">
              <a href={`/servicios/${s.slug}`} class="tarjeta group flex h-full flex-col gap-4 p-6">
                <span class="chip-icono h-11 w-11">
                  <ServiceIcon nombre={s.icono} className="h-5 w-5" />
                </span>
                <span>
                  <span class="block text-xl font-bold">{s.nombre}</span>
                  <span class="mt-2 block text-sm text-fg-muted">{s.resumenHome}</span>
                </span>
                <span class="text-eyebrow mt-auto flex items-center gap-1.5 text-fg-dim transition-colors group-hover:text-fg">
                  Ver servicio
                  <ArrowUpRight className="h-3.5 w-3.5" aria-hidden="true" />
                </span>
              </a>
            </RevealItem>
          ))
        }
      </RevealGroup>
    </div>
  </section>

  <FAQ
    preguntas={preguntas}
    numero={numero()}
    titulo={`Preguntas sobre ${agrupacion.nombre}`}
  />

  <CTASection titulo={`¿Necesitas un instalador en ${agrupacion.nombre}?`} />
</Base>
