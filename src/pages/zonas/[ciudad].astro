---
import { ArrowUpRight, MapPin, Route } from "lucide-react";
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import EnlaceBoton from "@/components/ui/EnlaceBoton.astro";
import Reveal from "@/components/ui/Reveal.astro";
import RevealGroup from "@/components/ui/RevealGroup.astro";
import RevealItem from "@/components/ui/RevealItem.astro";
import FAQ from "@/components/sections/FAQ.astro";
import CTASection from "@/components/sections/CTASection.astro";
import TarjetaProyecto from "@/components/sections/TarjetaProyecto.astro";
import { ServiceIcon } from "@/components/ui/ServiceIcon";
import { schemaFaq, schemaMigas, schemaZona } from "@/lib/schema";
import { crearMetadata } from "@/lib/seo";
import { zonas, type Zona } from "@/content/zonas";
import { getServicio } from "@/content/servicios";
import { proyectosPorZona } from "@/content/proyectos";
import { hrefWhatsApp, site } from "@/content/site";

/* Los slugs de zona son un conjunto cerrado y conocido: se generan todas sus
   páginas en la compilación y cualquier otra dirección da 404. */
export function getStaticPaths() {
  return zonas.map((zona) => ({ params: { ciudad: zona.slug }, props: { zona } }));
}

type Props = { zona: Zona };
const { zona } = Astro.props;

const migas = [
  { label: "Zonas", href: "/zonas" },
  { label: zona.ciudad, href: `/zonas/${zona.slug}` },
];

const meta = crearMetadata({
  title: zona.titleSeo,
  description: zona.descriptionSeo,
  path: `/zonas/${zona.slug}`,
});

const trabajos = proyectosPorZona(zona.slug).slice(0, 3);
const otrasZonas = zonas
  .filter((z) => z.slug !== zona.slug && z.comarca === zona.comarca)
  .slice(0, 5);

const demandados = zona.serviciosDemandados
  .map((demandado) => ({ demandado, servicio: getServicio(demandado.slug) }))
  .filter((entrada) => Boolean(entrada.servicio));
---

<Base meta={meta} schema={[schemaZona(zona), schemaFaq(zona.faq), schemaMigas(migas)]}>
  <header class="relative overflow-hidden pt-36 pb-16 md:pt-44 md:pb-20">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <div class="grid-plano absolute inset-0 opacity-70"></div>
      <div
        class="absolute inset-0"
        style="background:radial-gradient(65% 60% at 15% 0%, rgba(35,54,111,.65) 0%, transparent 60%)"
      >
      </div>
    </div>

    <div class="container-brand">
      <Breadcrumbs migas={migas} />

      <p class="text-eyebrow mt-8 mb-5 flex items-center gap-2.5 text-brand-orange">
        <MapPin className="h-3.5 w-3.5" aria-hidden="true" />
        {zona.comarca}
      </p>

      <h1 class="max-w-4xl text-6xl">{zona.h1}</h1>
      <p class="mt-6 max-w-2xl text-xl text-fg-muted">{zona.claim}</p>
      <p class="mt-6 max-w-3xl text-lg text-fg-muted">{zona.entradilla}</p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <EnlaceBoton href="/contacto" tamano="lg">Solicitar presupuesto</EnlaceBoton>
        <EnlaceBoton
          href={hrefWhatsApp(
            `Hola Alex, escribo desde ${zona.ciudad} y me gustaría pedir presupuesto.`,
          )}
          variante="secundario"
          tamano="lg"
        >
          WhatsApp
        </EnlaceBoton>
      </div>
    </div>
  </header>

  {/* Contexto real de la zona */}
  <section class="pb-section" aria-labelledby="titulo-contexto">
    <div class="container-brand">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.55fr)] lg:gap-16">
        <Reveal>
          <h2 id="titulo-contexto" class="sr-only">
            Cómo son las instalaciones en {zona.ciudad}
          </h2>
          <div class="prosa max-w-2xl text-lg">
            {zona.cuerpo.map((parrafo) => <p>{parrafo}</p>)}
          </div>
        </Reveal>

        <Reveal delay={0.1} class="flex flex-col gap-6">
          <div class="rounded-[2px] border border-white/10 bg-surface/50 p-6">
            <h3 class="text-eyebrow mb-4 flex items-center gap-2.5 text-brand-orange">
              <Route className="h-3.5 w-3.5" aria-hidden="true" />
              Desplazamiento
            </h3>
            <p class="text-sm text-fg-muted">{zona.desplazamiento}</p>
          </div>

          <div class="rounded-[2px] border border-white/10 bg-surface/50 p-6">
            <h3 class="text-eyebrow mb-4 text-fg-muted/50">Qué cubre esta zona</h3>
            <ul class="flex flex-wrap gap-2">
              {
                zona.cubre.map((sitio) => (
                  <li class="rounded-[2px] border border-white/12 px-2.5 py-1.5 text-xs text-fg-muted">
                    {sitio}
                  </li>
                ))
              }
            </ul>
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  {/* Barrios (solo donde aporta) */}
  {
    zona.barrios ? (
      <section class="py-section" aria-labelledby="titulo-barrios">
        <div class="container-brand">
          <SectionHeading
            numero="01"
            eyebrow="Barrios y distritos"
            tituloId="titulo-barrios"
            titulo={`Cada distrito de ${zona.ciudad}, su propio problema`}
          />

          <RevealGroup
            as="ul"
            class="mt-14 grid gap-3 sm:grid-cols-2 lg:grid-cols-3"
            stagger={0.04}
          >
            {zona.barrios.map((barrio) => (
              <RevealItem
                as="li"
                class="rounded-[2px] border border-white/10 bg-surface/40 p-6"
              >
                <h3 class="text-xl">{barrio.nombre}</h3>
                <p class="mt-2 text-sm text-fg-muted">{barrio.detalle}</p>
              </RevealItem>
            ))}
          </RevealGroup>
        </div>
      </section>
    ) : null
  }

  {/* Servicios más demandados */}
  <section class="py-section" aria-labelledby="titulo-demandados">
    <div class="container-brand">
      <SectionHeading
        numero={zona.barrios ? "02" : "01"}
        eyebrow="Lo que más se pide aquí"
        tituloId="titulo-demandados"
        titulo={`Servicios más demandados en ${zona.ciudad}`}
      />

      <RevealGroup as="ul" class="mt-14 grid gap-6 sm:grid-cols-2" stagger={0.07}>
        {
          demandados.map(({ demandado, servicio }) => (
            <RevealItem as="li">
              <a
                href={`/servicios/${servicio!.slug}`}
                class="barrido-z group flex h-full flex-col gap-4 rounded-[2px] border border-white/10 bg-surface/50 p-6 transition-colors hover:border-brand-blue/60 sm:p-7"
              >
                <span class="flex items-center justify-between gap-4">
                  <span class="flex items-center gap-3">
                    <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-[2px] border border-white/12 text-brand-blue transition-colors group-hover:border-brand-blue/60 group-hover:text-fg">
                      <ServiceIcon nombre={servicio!.icono} />
                    </span>
                    <span class="font-display text-2xl">
                      {servicio!.nombre} en {zona.ciudad}
                    </span>
                  </span>
                  <ArrowUpRight
                    className="h-5 w-5 shrink-0 text-fg-muted/40 transition-all group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-brand-orange"
                    aria-hidden="true"
                  />
                </span>
                <span class="text-sm text-fg-muted">{demandado.motivo}</span>
              </a>
            </RevealItem>
          ))
        }
      </RevealGroup>
    </div>
  </section>

  {/* Trabajos en la zona */}
  <section class="py-section" aria-labelledby="titulo-trabajos-zona">
    <div class="container-brand">
      <SectionHeading
        numero={zona.barrios ? "03" : "02"}
        eyebrow="Trabajos realizados"
        tituloId="titulo-trabajos-zona"
        titulo={`Obra hecha en ${zona.ciudad}`}
      />

      {
        trabajos.length > 0 ? (
          <RevealGroup class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {trabajos.map((proyecto) => (
              <RevealItem>
                <TarjetaProyecto proyecto={proyecto} />
              </RevealItem>
            ))}
          </RevealGroup>
        ) : (
          <Reveal class="mt-14">
            <div class="rounded-[2px] border border-dashed border-white/15 bg-surface/40 p-8">
              <p class="text-eyebrow text-brand-orange">Pendiente de contenido</p>
              <p class="mt-3 max-w-2xl text-fg-muted">
                Aquí van los trabajos realizados en {zona.ciudad}. No se publican
                proyectos inventados ni se recicla obra de otra zona para rellenar: en
                cuanto haya material real de este municipio, aparece aquí y en la
                galería.
              </p>
            </div>
          </Reveal>
        )
      }
    </div>
  </section>

  <FAQ
    preguntas={zona.faq}
    numero={zona.barrios ? "04" : "03"}
    titulo={`Preguntas frecuentes en ${zona.ciudad}`}
    eyebrow="Dudas de la zona"
  />

  {/* Zonas vecinas */}
  {
    otrasZonas.length > 0 ? (
      <section class="pb-section" aria-labelledby="titulo-vecinas">
        <div class="container-brand">
          <h2
            id="titulo-vecinas"
            class="text-eyebrow mb-6 flex items-center gap-3 text-fg-muted/50"
          >
            También trabajo en {zona.comarca}
            <span class="cota flex-1" aria-hidden="true" />
          </h2>
          <ul class="flex flex-wrap gap-2">
            {otrasZonas.map((otra) => (
              <li>
                <a
                  href={`/zonas/${otra.slug}`}
                  class="inline-flex min-h-11 items-center rounded-[2px] border border-white/12 px-3.5 text-sm text-fg-muted transition-colors hover:border-brand-blue hover:text-fg"
                >
                  {otra.ciudad}
                </a>
              </li>
            ))}
            <li>
              <a
                href="/zonas"
                class="inline-flex min-h-11 items-center px-3.5 text-sm text-fg hover:text-brand-orange"
              >
                Ver todas las zonas
              </a>
            </li>
          </ul>
        </div>
      </section>
    ) : null
  }

  <CTASection
    titulo={`Instalaciones en ${zona.ciudad}`}
    descripcion={`Cuéntame qué necesitas y respondo en ${site.respuesta} con una primera valoración. Sin coste y sin compromiso.`}
  />
</Base>
