# ---------------------------------------------------------------------------
# ZSolutions — variables de entorno
#
# Copia este fichero a `.env` para desarrollo local, y define las mismas
# variables en Vercel (Project → Settings → Environment Variables).
# Ninguna es obligatoria para que la web compile y se despliegue: sin ellas
# el sitio funciona, pero el formulario no envía correo y la web se publica
# en `noindex`.
# ---------------------------------------------------------------------------

# --- Envío del formulario de presupuesto (función `api/presupuesto.ts`) ---
# Clave de API de Resend. https://resend.com/api-keys
RESEND_API_KEY=

# Remitente verificado en Resend, p. ej. "ZSolutions <web@tu-dominio.com>".
# Tiene que ser un dominio verificado allí; si no, Resend rechaza el envío.
EMAIL_REMITENTE=

# Dirección que recibe las solicitudes. Si se deja vacía se usa el email
# declarado en `src/content/site.ts`.
EMAIL_DESTINATARIO=

# --- Dominio e indexación ---
# Dominio definitivo, con protocolo: https://zsolutions.es
# Definirlo hace dos cosas a la vez: fija las URL canónicas, el sitemap y las
# miniaturas sociales, y abre la web a los buscadores. Mientras esté vacío, la
# web se publica en `noindex` para no dejar indexada la dirección provisional
# de Vercel. En las previsualizaciones nunca se indexa, se ponga lo que se ponga.
PUBLIC_SITE_URL=

# Solo si quieres que la dirección provisional de Vercel entre en Google antes
# de tener dominio. Valor: true
PUBLIC_PERMITIR_INDEXACION=
