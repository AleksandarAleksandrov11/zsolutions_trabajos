{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "astro build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/presupuesto",
      "destination": "/contacto",
      "permanent": true
    },
    {
      "source": "/sobre-mi",
      "destination": "/sobre-alex",
      "permanent": true
    },
    {
      "source": "/servicios/lampista",
      "destination": "/servicios/lampisteria",
      "permanent": true
    },
    {
      "source": "/servicios/aire-acondicionado",
      "destination": "/servicios/climatizacion",
      "permanent": true
    },
    {
      "source": "/servicios/trabajos-en-altura",
      "destination": "/servicios/trabajos-verticales",
      "permanent": true
    },
    {
      "source": "/formacion",
      "destination": "/sobre-alex",
      "permanent": true
    },
    {
      "source": "/zonas/barcelona",
      "destination": "/zonas/barcelona-ciudad",
      "permanent": true
    },
    {
      "source": "/zonas/hospitalet-de-llobregat",
      "destination": "/zonas/baix-llobregat",
      "permanent": true
    },
    {
      "source": "/zonas/badalona",
      "destination": "/zonas/barcelones-nord",
      "permanent": true
    },
    {
      "source": "/zonas/santa-coloma-de-gramenet",
      "destination": "/zonas/barcelones-nord",
      "permanent": true
    },
    {
      "source": "/zonas/sant-adria-de-besos",
      "destination": "/zonas/barcelones-nord",
      "permanent": true
    },
    {
      "source": "/zonas/cornella-de-llobregat",
      "destination": "/zonas/baix-llobregat",
      "permanent": true
    },
    {
      "source": "/zonas/sant-boi-de-llobregat",
      "destination": "/zonas/baix-llobregat",
      "permanent": true
    },
    {
      "source": "/zonas/esplugues-de-llobregat",
      "destination": "/zonas/baix-llobregat",
      "permanent": true
    },
    {
      "source": "/zonas/el-prat-de-llobregat",
      "destination": "/zonas/baix-llobregat",
      "permanent": true
    },
    {
      "source": "/zonas/castelldefels",
      "destination": "/zonas/baix-llobregat",
      "permanent": true
    },
    {
      "source": "/zonas/sitges",
      "destination": "/zonas",
      "permanent": true
    },
    {
      "source": "/zonas/vilanova-i-la-geltru",
      "destination": "/zonas",
      "permanent": true
    },
    {
      "source": "/zonas/sant-cugat-del-valles",
      "destination": "/zonas/valles-occidental",
      "permanent": true
    },
    {
      "source": "/zonas/cerdanyola-del-valles",
      "destination": "/zonas/valles-occidental",
      "permanent": true
    },
    {
      "source": "/zonas/sabadell",
      "destination": "/zonas/valles-occidental",
      "permanent": true
    },
    {
      "source": "/zonas/terrassa",
      "destination": "/zonas/valles-occidental",
      "permanent": true
    },
    {
      "source": "/zonas/mollet-del-valles",
      "destination": "/zonas",
      "permanent": true
    },
    {
      "source": "/zonas/granollers",
      "destination": "/zonas",
      "permanent": true
    },
    {
      "source": "/zonas/mataro",
      "destination": "/zonas",
      "permanent": true
    },
    {
      "source": "/zonas/manresa",
      "destination": "/zonas",
      "permanent": true
    },
    {
      "source": "/zonas/girona",
      "destination": "/zonas",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(fonts|logo)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
